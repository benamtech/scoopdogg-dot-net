{
  "name": "scoopdogg-dot-net",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node gates/build-gates.mjs",
    "build:only": "astro build",
    "preview": "astro preview",
    "gates": "node gates/build-gates.mjs",
