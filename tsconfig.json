{
  "$schema": "https://json.schemastore.org/tsconfig",
  // ONE project, extending Astro's own base. The predecessor was the Vite template's
  // `{ files: [], references: [...] }`, which `astro check` reads as a project that contains
  // no files: it fell back to defaults, never loaded `.astro/types.d.ts`, and therefore typed
  // every `import mascot from '../assets/art/x.png'` as a plain string. Thirteen of the twenty
  // errors that appeared the first time this gate could run were that one line.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // The React islands (admin, booking, account) are compiled by @astrojs/react.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // src/lib/demo.ts imports content/demo.json, which the build writes as step one.
    "resolveJsonModule": true,
    // THE SERVERLESS BUILD USES THIS FILE AND gates/_compile.mjs DOES NOT, which is how the
    // funnel came to be dead on a deployment while twenty gates were green (2026-09-19).
    //
    // src/shared is loaded three ways and each resolver wants a different specifier: Node's
    // type-stripper (`node --test tests/*.test.ts`) resolves the literal one and will not
    // rewrite `.js` to `.ts`; Vite resolves either; the emitted serverless JS needs `.js`.
    // So the source says `./pricing.ts` and the compiler rewrites it on the way out. The gate
    // compile passed these two on the command line; Vercel reads them from here, and without
    // them `src/shared/consent.js` shipped importing `./pricing.ts` - a file that is not in
    // the bundle - so /api/booking/price and /api/booking/track answered 500.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "server/**/*", "api/**/*"],
  "exclude": ["dist", "node_modules", ".gate-build", "output"]
}
