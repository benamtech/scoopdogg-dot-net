---
/**
 * The one <head> for every page, emitted SERVER-SIDE.
 *
 * The old site built its head at runtime with useSEO(), which mutated document.head
 * after React mounted. With prerendering skipped in production that never ran, so all
 * 71 URLs served index.html's homepage <title> and no <h1>. Passing meta as props to a
 * layout is what makes "every page has its own title" true by construction instead of
 * true only when JavaScript happens to execute.
 *
 * 2026-09-16: fonts are self-hosted (src/index.css), so there is no request to Google
 * before first paint; icons and the manifest come from public/brand.
 */
import '../index.css';
import { SITE_URL, DEFAULT_OG_IMAGE, SITE_NAME } from '../lib/constants';
// `demo.mode` from the database, read for this render by src/middleware.ts, so the banner and
// the noindex are in the HTML a crawler receives. A banner added after the page loaded would be
// invisible to a crawler and to any gate that reads the rendered HTML.
import { DEMO_MODE, DEMO_BANNER_TEXT } from '../lib/demo';
// The analytics tag is a ROW, not a constant. See the block below for why that matters.
import { setting } from '../lib/catalog';
// Preload the two faces every page paints with, so the headline does not wait on font discovery.
import outfitUrl from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import serifUrl from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';

export interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  bodyClass?: string;
}

const { title, description, canonicalPath, ogImage, jsonLd, noindex = false, bodyClass = '' } = Astro.props;
/**
 * The GA4 property, from a row. Empty renders no tag at all.
 *
 * THE DEFAULT IS EMPTY, which means this site ships no third-party JavaScript. Measured
 * 2026-09-19 with `scripts/measure-script-cost.mjs`, five samples per arm, same page and same
 * minute with the tag's hosts blocked at the network layer so machine noise lands on both:
 *
 *     page             script (tag on)   script (tag off)   JS downloaded
 *     /                     214ms              15ms          172KB -> 0
 *     /areas/ventura        245ms               5ms          172KB -> 0
 *     /pricing              252ms               7ms          172KB -> 0
 *
 * ~240ms of main-thread script and ONE HUNDRED PER CENT of the JavaScript on a content page.
 * Total task duration on /areas/ventura halves, 458ms to 232ms. Unthrottled 240ms against
 * Lighthouse's 4x CPU throttle is ~960ms, which is the 830ms Total Blocking Time measured on
 * that page by a completely different route — two instruments, one answer.
 *
 * It was already deferred to first-interaction-or-idle in September and it is STILL the largest
 * cost on every page. Deferring it further would move the Lighthouse number without moving
 * anything a visitor experiences, which is gaming the only instrument this site has (R10 §1).
 *
 * P19 §2 decided the scoreboard before this: "net adds, sessions, conversion — the only
 * scoreboard ... from `events` and the money rows — no analytics vendor, no third-party script,
 * no cookie banner." Step 5 built that spine (`funnel_sessions`, the funnel events) and the
 * growth board reads it. GA was inherited from the predecessor site and is now measuring
 * something we measure ourselves, at the cost of every page's only JavaScript.
 *
 * TO PUT IT BACK, one row — and since 2026-09-29 that is true, with no build and no deploy:
 *
 *     node scripts/set-setting.mjs analytics.measurement_id '"G-SNLVJNSP05"'
 *
 * The pages render from the rows (src/middleware.ts), and the key is in PUBLIC_SETTINGS
 * (server/lib/public-catalog.ts), which gates/settings-have-readers.mjs resolves this read
 * against. Until 2026-09-26 the allowlist did not carry the key and until 2026-09-29 the pages
 * were built from a file, so this comment's earlier advice wrote a row the site could never see.
 * set-setting.mjs purges the page cache like an admin save does.
 *
 * AND READ THE LAST SENTENCE THE RIGHT WAY ROUND. The historical GA data is untouched either
 * way. Production is still the predecessor build and is still serving G-SNLVJNSP05 today
 * (measured 2026-09-26), so promoting this branch TURNS GA OFF rather than leaving it alone.
 * That is a deliberate choice — P19 §2 chose the first-party spine over a vendor tag — but it
 * is a change to what production does, and the promotion checklist in SPEC step 11 names it.
 */
const measurementId = setting<string>('analytics.measurement_id', '');
// Search Console ownership (scripts/search-console.mjs). A setting, not code: the token is public by design.
const googleVerification = setting<string>('google.site_verification', '');
// A demo build is never indexable, whatever the page asked for. A demo booking page in
// Google's index outlives the demo.
const isNoindex = noindex || DEMO_MODE;
const canonical = `${SITE_URL}${canonicalPath}`;
const image = ogImage || DEFAULT_OG_IMAGE;
// EVERY INDEXABLE PAGE CARRIES STRUCTURED DATA, and a page that does not name its own gets a
// WebPage node built from the props it already passed. Seven pages - /about, /areas, /book,
// /careers, /commercial, /how-it-works, /services - shipped with none at all, which R8 §F calls
// the machine-readable layer and Google's AI-features guidance asks for first.
//
// It is built from `title`, `description` and `canonical` rather than written per page ON PURPOSE:
// structured data that is authored separately drifts from the visible text, and the rule this
// repository holds (STANDARD.md §4.3) is that a page may not claim to a machine what a reader
// cannot see. These three ARE what the reader sees.
const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'en-US',
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
};
const schema = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : (isNoindex ? null : [defaultSchema]);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#143728" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/mark-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/mark-192.png" />
    <link rel="apple-touch-icon" href="/brand/mark-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={outfitUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* WHY it is noindex, for gates/build-gates.mjs: a page that is private ("page") and a page that is
        noindex only because this is a demo build ("demo", every preview) must not be confused. */}
    <meta name="robots" content={isNoindex ? 'noindex, nofollow' : 'index, follow'} data-noindex={noindex ? 'page' : DEMO_MODE ? 'demo' : undefined} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <slot name="head" />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema.length === 1 ? schema[0] : schema)} />
    )}

    <!--
      GA4, loaded after the first interaction or when the browser is idle. Events queue in
      dataLayer until it arrives, so nothing is lost - including booking_step and purchase.

      IT IS A SETTING NOW, and the reason is a measurement. The deferral above was added on
      2026-09-16 because the tag cost ~500ms of main-thread time; re-measured on 2026-09-19
      after the design port, it is STILL the single largest cost on every page. On
      /areas/ventura it is the ONLY script on the page - this site ships 0KB of its own
      JavaScript on content pages - and Total Blocking Time is 830ms. The homepage swings
      between 74 and 89 on identical runs, and the swing tracks TBT exactly.

      Deferring it further would move the Lighthouse number without moving anything a visitor
      experiences, which is gaming the only instrument we have (R10 §1). So the lever is
      whether to keep the tag at all - and that is Ben's call, not a code change. P19 §2
      already decided the scoreboard is our own `events` rows, "no analytics vendor, no
      third-party script, no cookie banner", and step 5 built that spine. This makes the
      decision one row:

        node scripts/set-setting.mjs analytics.measurement_id ""

      An empty id renders no tag at all.
    -->
    {measurementId && (
    <script is:inline define:vars={{ measurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', measurementId);
      (function () {
        var loaded = false;
        function load() {
          if (loaded) return; loaded = true;
          var s = document.createElement('script');
          s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
          document.head.appendChild(s);
        }
        ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (e) { addEventListener(e, load, { once: true, passive: true }); });
        addEventListener('load', function () {
          if (window.requestIdleCallback) requestIdleCallback(load, { timeout: 3500 }); else setTimeout(load, 3500);
        });
      })();
    </script>
    )}

    <!--
      WHERE THIS VISIT CAME FROM, captured once and kept for the session (migration 033).

      `document.referrer` is the ONLY place the original referrer survives, and it survives for
      exactly one page load: click through to a second page of this site and it becomes
      scoopdogg.net. So the first page of a session writes it down and every later page leaves it
      alone — which is why this is here, in the layout every page uses, and not in the booking
      island the visitor may never reach.

      IT IS NOT A COOKIE AND NOT AN IDENTIFIER. One hostname, in sessionStorage, gone when the tab
      closes, never read by anything but our own /api/booking/track. Same-site referrers are
      dropped rather than stored, so an internal click reads as direct rather than as a channel.
      P19 §2's "no analytics vendor, no third-party script, no cookie banner" still holds.
    -->
    <script is:inline>
      try {
        if (!sessionStorage.getItem('sd_src')) {
          var ref = document.referrer || '';
          var host = '';
          try { host = ref ? new URL(ref).hostname.replace(/^www\./, '') : ''; } catch (e) { host = ''; }
          // A PAID CLICK IS NOT AN ORGANIC ONE, and from the referrer alone they are the same
          // site. An ad platform marks its own clicks in the landing URL (gclid and its two
          // siblings for Google, msclkid for Microsoft), and a tagged campaign says so in
          // utm_medium. Those sessions are stored as `paid.<site>`, so the growth page can tell
          // what an advert brought from what a search result did. Only the marker's presence is
          // read; the click id itself is never stored.
          var q = new URLSearchParams(location.search);
          var paid = q.get('gclid') || q.get('gbraid') || q.get('wbraid') ? 'google.com'
            : q.get('msclkid') ? 'bing.com'
            : /^(cpc|ppc|paid|paidsearch|paidsocial|paid_social|display)$/i.test(q.get('utm_medium') || '') ? (host || (q.get('utm_source') || 'ad').toLowerCase().replace(/[^a-z0-9.-]/g, ''))
            : '';
          if (paid) sessionStorage.setItem('sd_src', 'paid.' + paid);
          else if (host && host !== location.hostname.replace(/^www\./, '')) sessionStorage.setItem('sd_src', host);
        }
      } catch (e) { /* measurement is never load-bearing */ }
    </script>
  </head>
  <body class={`bg-paper text-ink-900 font-sans antialiased ${bodyClass}`}>
    {DEMO_MODE && (
      <div
        data-demo-banner
        role="status"
        class="border-b-2 border-amber-600 bg-amber-100 px-4 py-2.5 text-center text-sm font-medium text-amber-700"
      >
        {DEMO_BANNER_TEXT}
      </div>
    )}
    <slot />
  </body>
</html>
