---
/**
 * One service card, in the shape Josue's customers comment on.
 *
 * P15 §2 row 3 — the Our Services band "carries over whole; this is the part that gets the
 * comments". The live card is a cartoon, an `Includes:` list, a price and its own CTA, and all
 * four come across. Three things change, and each of them is a defect being removed:
 *
 *  1. THE PRICE RESOLVES FROM A ROW. The live cards type their prices into the markup —
 *     "1 dog · $15/week", "Starting at $99" — and the ladder moved to $100/$120/$130/$160 in
 *     migration 016, so every one of those strings is now wrong as well as unmaintainable.
 *     `gates/no-price-in-prose.mjs` and `gates/price-four-places.mjs` are what keep them out.
 *  2. THE CTA ENTERS THE FUNNEL AT THIS SERVICE, not `/contact`. The two biggest tickets in
 *     the catalog used to be a contact link (P16 §3).
 *  3. THE CARTOON GOES THROUGH `astro:assets`, so it is resized and served as WebP. The live
 *     site serves the full PNGs, which is most of its 5.7MB.
 *
 * ONE CARD RENDERER, and the comment on the live component says why: there used to be two —
 * `ServiceCard` and an inline block for the pet add-ons — so a prop added to the component
 * reached half the cards, and the Litter-Robot artwork sat over its own heading for two
 * reports running. There is one here, and the add-ons use it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  slug: string;
  name: string;
  /** One line under the name. The live card calls this `sub`. */
  sub: string;
  description: string;
  /** From `service.what_includes` — a row, not a literal. */
  includes: string[];
  includesLabel?: string;
  /** Rendered from a row by the caller; `null` means "ask", not "free". */
  price: { text: string; per: string; cents: number } | null;
  priceNote?: string | null;
  cta: string;
  /** The cartoon. Optional: a service without one renders without one. */
  art?: ImageMetadata;
  artAlt?: string;
  badge?: string | null;
  /** The one card per group that carries the brand's weight. */
  featured?: boolean;
}
const {
  slug, name, sub, description, includes, includesLabel = 'Includes:',
  price, priceNote = null, cta, art, artAlt = '', badge = null, featured = false,
} = Astro.props;

// Straight into the funnel at this service. `/book?service=` is what BookingFlow reads on load.
const href = `/book?service=${encodeURIComponent(slug)}`;
---
<article
  class={`group relative flex h-full flex-col overflow-hidden rounded-xl border bg-paper transition duration-base ease-brand hover:-translate-y-0.5 hover:shadow-md ${
    featured ? 'border-forest-500 ring-1 ring-forest-500' : 'border-line-strong'
  }`}
  data-service-card={slug}
>
  {badge && (
    <span class="absolute right-4 top-4 z-10 rounded-full bg-amber-500 px-3 py-1 text-micro font-semibold uppercase tracking-wide text-forest-900">
      {badge}
    </span>
  )}

  {art && (
    // The artwork is a framed scene in the flow, never floated over the heading. The live
    // site's `framedMascot` note is the same rule and it was learned the hard way.
    <div class="aspect-[16/10] w-full overflow-hidden bg-forest-50">
      <Image
        src={art}
        alt={artAlt}
        widths={[320, 480, 640]}
        sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-contain p-4 transition duration-base group-hover:scale-[1.02]"
      />
    </div>
  )}

  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-serif text-h4 text-forest-900">{name}</h3>
    <p class="mt-1 text-sm font-medium uppercase tracking-wide text-ink-500">{sub}</p>
    <p class="mt-3 text-base leading-relaxed text-ink-700">{description}</p>

    {includes.length > 0 && (
      <>
        <p class="mt-5 text-sm font-semibold text-forest-900">{includesLabel}</p>
        <ul class="mt-2 space-y-1.5">
          {includes.slice(0, 5).map((line) => (
            <li class="flex gap-2 text-base text-ink-700">
              <svg class="mt-1.5 shrink-0 text-forest-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
              <span>{line}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    <div class="mt-auto pt-6">
      {price ? (
        // `data-price-cents` is how gates/price-four-places.mjs finds a price on a page. A
        // dollar sign outside one of these is what no-price-in-prose fails on.
        <p class="flex items-baseline gap-1.5" data-price-cents={price.cents}>
          <span class="font-serif text-h3 text-forest-900">{price.text}</span>
          {price.per && <span class="text-base text-ink-500">{price.per}</span>}
        </p>
      ) : (
        <p class="text-base font-medium text-forest-800">Priced after a quick look at your yard</p>
      )}
      {priceNote && <p class="mt-1 text-sm text-ink-500">{priceNote}</p>}
      <a href={href} class="btn-primary btn-md mt-4 w-full justify-center" data-cta={`service-${slug}`}>{cta}</a>
    </div>
  </div>
</article>
