---
/**
 * One of the groups the live Our Services section is divided into — Yard Cleaning, Turf
 * Maintenance, Landscaping, Extra Pet Services — as scoopdogg.net draws it: A BAND OF ITS OWN,
 * alternating sage and white, opening with a small uppercase label, a serif title and a
 * paragraph, then the cards.
 *
 * The grouping is the part of the page people navigate by — a visitor with a cat reads two
 * headings and stops — and on the live site each group is a different colour, which is what
 * makes the long section readable at a scroll. The heading is an h3 because the section's own
 * "Our Services" is the h2, and `gates/build-gates.mjs` checks a page has exactly one h1.
 */
import Section from './Section.astro';
export interface Props {
  label: string;
  title: string;
  lede?: string;
  tone?: 'sage' | 'white' | 'cream';
  /** Two wide cards (the live turf and landscaping rows) or three. */
  cols?: 2 | 3;
}
const { label, title, lede, tone = 'white', cols = 3 } = Astro.props;
const grid = cols === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---
<Section tone={tone} class="overflow-visible">
  <div data-service-group={label}>
    <div class="mb-10 max-w-2xl md:mb-14">
      <p class="text-micro font-bold uppercase text-tone-accent">{label}</p>
      <h3 class="mt-2 font-serif text-h2 text-tone-heading">{title}</h3>
      {lede && <p class="mt-4 text-lg text-tone-muted">{lede}</p>}
    </div>
    <div class={`grid gap-10 sm:gap-6 ${grid}`}>
      <slot />
    </div>
    <slot name="after" />
  </div>
</Section>
