---
/**
 * The monthly packages of one service, straight from the rows, priced by the shared
 * resolver. The monthly price is the headline; the per-visit equivalent sits under it so a
 * visitor comparing against "$15 a week" elsewhere can see it is the same money (R5 §7).
 *
 * The featured package is drawn on the brand green with white text and raised: people read the
 * highlighted, central option as the popular one (R6 §A3, Valenzuela & Raghubir 2009). The
 * label only appears on the row flagged `featured`, so it stays true.
 */
import { packagesForService, formatCents } from '../../lib/catalog';
import { offersFor } from '../../shared/pricing';
import { catalog } from '../../lib/catalog';

export interface Props { service: string; compact?: boolean }
const { service, compact = false } = Astro.props;
const list = packagesForService(service);
const offer = offersFor(catalog, service, [service]).sort((a, b) => b.value - a.value)[0];
const perVisit = (cents: number, visits: number) => formatCents(Math.round(cents / visits / 100) * 100);
const freq = { weekly: 'every week', biweekly: 'every other week', twice_weekly: 'twice a week', monthly: 'once a month' } as const;
const cols = list.length >= 4 ? 'lg:grid-cols-4' : list.length === 3 ? 'lg:grid-cols-3' : '';
---
{list.length > 0 && (
  <div class={`grid grid-cols-2 items-stretch gap-3 sm:gap-4 lg:gap-5 ${cols}`}>
    {list.map((p) => {
      const first = offer ? p.monthly_price_cents - Math.round((p.monthly_price_cents * offer.value) / 100) : null;
      const hot = p.featured;
      return (
        <a
          href={`/book?package=${p.slug}`}
          class={`group relative flex flex-col rounded-xl p-4 transition duration-base ease-brand hover:-translate-y-1 sm:p-6 ${hot
            ? 'tone-forest bg-tone-bg text-tone-fg shadow-lg lg:-my-3 lg:py-9'
            : 'tone-white border border-line bg-paper shadow-sm hover:border-forest-300 hover:shadow-md'}`}
          data-package={p.slug}
        >
          {hot && (
            <span class="absolute -top-3 left-4 inline-flex items-center gap-1.5 rounded-sm bg-amber-500 px-2.5 py-1 text-micro font-semibold uppercase text-forest-900 sm:left-6">
              <svg width="12" height="12" viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
              Most booked
            </span>
          )}
          <p class="text-base font-semibold text-tone-heading">{p.short_label}</p>
          <p class="mt-3 flex items-baseline gap-1">
            <span class="font-serif text-h2 leading-none text-tone-heading" data-price-cents={p.monthly_price_cents}>{formatCents(p.monthly_price_cents)}</span>
            <span class="text-sm text-tone-muted sm:text-base">/mo</span>
          </p>
          <p class="mt-2 text-sm text-tone-muted">About {perVisit(p.monthly_price_cents, p.visits_per_month)} a visit<span class="hidden sm:inline">, {freq[p.frequency]}</span></p>
          {first !== null && !compact && (
            <p class={`mt-4 border-t pt-4 text-sm ${hot ? 'border-white/15 text-white' : 'border-line text-ink-700'}`}>
              First month <span class={`font-semibold ${hot ? 'text-amber-400' : 'text-orange-700'}`}>{formatCents(first, { forceDecimals: first % 100 !== 0 })}</span><span class="hidden sm:inline"> — half off</span>
            </p>
          )}
          <span class="flex-1"></span>
          <span class={`mt-5 w-full ${hot ? 'btn-primary' : 'btn-ghost'} btn-sm sm:py-3 sm:text-base`}>
            Choose<span class="sr-only"> {p.short_label}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true" class="transition duration-fast group-hover:translate-x-0.5"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </a>
      );
    })}
  </div>
)}
