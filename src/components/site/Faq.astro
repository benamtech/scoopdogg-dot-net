---
/** Native <details>: accessible, zero JavaScript, and the answers are in the HTML for crawlers. */
export interface Props { items: { q: string; a: string }[]; schema?: boolean }
const { items } = Astro.props;
---
<div class="divide-y divide-line rounded-lg border border-line bg-paper">
  {items.map((f, i) => (
    <details class="group px-5 sm:px-7" open={i === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-semibold text-forest-900 [&::-webkit-details-marker]:hidden">
        {f.q}
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-forest-50 text-forest-700 transition duration-fast group-open:rotate-45" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        </span>
      </summary>
      <p class="max-w-prose pb-6 text-base text-ink-700">{f.a}</p>
    </details>
  ))}
</div>
