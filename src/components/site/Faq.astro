---
/**
 * Native <details>: accessible, zero JavaScript, and the answers are in the HTML for crawlers.
 * Drawn as open rows on the page rather than a boxed widget; the plus turns orange when open.
 */
export interface Props {
  items: { q: string; a: string }[]; schema?: boolean; openFirst?: boolean;
  /** Inside a white card (the live site's FAQ): no outer rules, the last row unruled. */
  card?: boolean;
}
const { items, openFirst = true, card = false } = Astro.props;
---
<div class={card ? '[&>details:last-child]:border-b-0' : 'border-t border-line'}>
  {items.map((f, i) => (
    <details class="group border-b border-line" open={openFirst && i === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-semibold text-forest-900 transition duration-fast hover:text-forest-600 [&::-webkit-details-marker]:hidden">
        {f.q}
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line-strong text-forest-700 transition duration-base ease-brand group-open:rotate-45 group-open:border-amber-500 group-open:bg-amber-500 group-open:text-forest-900" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        </span>
      </summary>
      <p class="max-w-prose pb-7 pr-12 text-lg text-ink-700">{f.a}</p>
    </details>
  ))}
</div>
