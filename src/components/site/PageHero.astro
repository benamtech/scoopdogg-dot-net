---
/**
 * The top of an inner page: breadcrumb, eyebrow, H1, lede, and on the right either the first
 * step of booking on a white card (`form`) or anything in the `aside` slot. `tone="forest"`
 * puts the page's first impression on the brand green with white text; the form card stays
 * white, which is the white/green combination Ben asked for.
 */
import AddressForm from './AddressForm.astro';
import { headlineOffer } from '../../lib/catalog';
export interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  crumbs?: { href: string; label: string }[];
  form?: boolean;
  formService?: string;
  formCity?: string;
  formTitle?: string;
  source?: string;
  tone?: 'white' | 'forest';
}
const { eyebrow, title, lede, crumbs = [], form = false, formService, formCity, formTitle = 'See your price in a minute', source = 'page-hero', tone = 'white' } = Astro.props;
const aside = form || Astro.slots.has('aside');
---
<section class={`tone-${tone} relative overflow-hidden bg-tone-bg ${tone === 'white' ? 'border-b border-line' : ''}`}>
  <div class={`container-site relative grid gap-10 py-12 lg:grid-cols-12 lg:gap-12 lg:py-20 ${aside ? 'lg:items-center' : ''}`}>
    <div class={aside ? 'lg:col-span-7' : 'lg:col-span-9'}>
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-tone-muted">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href="/" class="hover:text-tone-heading hover:underline">Home</a></li>
            {crumbs.map((c) => <li class="flex items-center gap-1.5"><span aria-hidden="true" class="opacity-60">/</span><a href={c.href} class="hover:text-tone-heading hover:underline">{c.label}</a></li>)}
          </ol>
        </nav>
      )}
      {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
      <h1 class={`${title.length > 48 ? 'text-h2' : 'text-h1'} text-tone-heading`}>{title}</h1>
      {lede && <p class="mt-6 max-w-prose text-lg text-tone-fg">{lede}</p>}
      <slot />
    </div>
    {aside && (
      <div class="lg:col-span-5">
        {form ? (
          <div class="tone-white rounded-xl bg-paper p-5 shadow-lg ring-1 ring-black/5 sm:p-7">
            <p class="font-serif text-h3 text-forest-900">{formTitle}</p>
            <p class="mt-1.5 text-base text-ink-500">Your monthly price before we ask for anything else.</p>
            <div class="mt-5"><AddressForm size="md" service={formService} city={formCity} source={source} heroAnchor flat label="Where is your yard?" /></div>
            <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-ink-700">
              <li class="inline-flex items-center gap-1.5"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="text-forest-500" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>{headlineOffer?.name ?? 'Cancel anytime'}</li>
              <li class="inline-flex items-center gap-1.5"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="text-forest-500" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>No contract</li>
            </ul>
          </div>
        ) : <slot name="aside" />}
      </div>
    )}
  </div>
</section>
