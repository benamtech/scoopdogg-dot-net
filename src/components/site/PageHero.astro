---
/**
 * The top of an inner page, as scoopdogg.net opens every one of them: a band of the brand green
 * with the serif title in white. With nothing beside it the heading is CENTRED, which is the
 * live page header exactly. With the first step of booking on its white card (`form`), or
 * anything in the `aside` slot, the heading sits left and the card right.
 *
 * ON A PHONE THE FORM COMES STRAIGHT AFTER THE TITLE, before the paragraph. Measured 2026-10-02
 * on the sixteen city pages and four monthly-plan service pages: the form was below the lede, so
 * the first screen of the page a searcher lands on had a heading, a paragraph and nothing to do.
 * The grid puts the card in the second row on one column and beside both rows on a wide screen.
 */
import AddressForm from './AddressForm.astro';
import { headlineOffer } from '../../lib/catalog';
export interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  crumbs?: { href: string; label: string }[];
  form?: boolean;
  formService?: string;
  formTitle?: string;
  source?: string;
  /** Any surface. `cream` is the usual choice for an inner page, so the band under it can be
   *  white without the page opening on two whites in a row (gates/surface-rhythm.mjs). */
  tone?: 'white' | 'cream' | 'sand' | 'tint' | 'sage' | 'forest';
}
const { eyebrow, title, lede, crumbs = [], form = false, formService, formTitle = 'See your price in a minute', source = 'page-hero', tone = 'forest' } = Astro.props;
const aside = form || Astro.slots.has('aside');
---
<section class={`tone-${tone} relative overflow-hidden bg-tone-bg ${tone === 'white' ? 'border-b border-line' : ''}`}>
  <div class={`container-site relative py-12 lg:py-20 ${aside ? 'grid gap-x-12 gap-y-7 lg:grid-cols-12 lg:items-center' : 'text-center'}`}>
    <div class={aside ? 'lg:col-span-7 lg:self-end' : 'mx-auto max-w-3xl'}>
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-tone-muted">
          <ol class={`flex flex-wrap items-center gap-1.5 ${aside ? '' : 'justify-center'}`}>
            <li><a href="/" class="hover:text-tone-heading hover:underline">Home</a></li>
            {crumbs.map((c) => <li class="flex items-center gap-1.5"><span aria-hidden="true" class="opacity-60">/</span><a href={c.href} class="hover:text-tone-heading hover:underline">{c.label}</a></li>)}
          </ol>
        </nav>
      )}
      {eyebrow && <p class="mb-4 text-micro font-bold uppercase text-tone-accent">{eyebrow}</p>}
      <h1 class={`${title.length > 48 ? 'text-h2' : 'text-h1'} text-tone-heading`}>{title}</h1>
    </div>
    {aside && (
      <div class="lg:col-span-5 lg:row-span-2">
        {form ? (
          <div class="tone-white rounded-card bg-paper p-5 shadow-lg ring-1 ring-black/5 sm:p-7">
            <p class="font-serif text-h3 text-forest-900">{formTitle}</p>
            <p class="mt-1.5 text-base text-ink-500">Your price before we ask for anything else.</p>
            <div class="mt-5"><AddressForm size="md" service={formService} source={source} heroAnchor flat stack label="Where is your yard?" /></div>
            <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-ink-700">
              <li class="inline-flex items-center gap-1.5"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-forest-500" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>{headlineOffer?.name ?? 'Cancel anytime'}</li>
              <li class="inline-flex items-center gap-1.5"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-forest-500" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>No contract</li>
            </ul>
          </div>
        ) : <slot name="aside" />}
      </div>
    )}
    <div class={aside ? 'lg:col-span-7 lg:self-start' : 'mx-auto max-w-2xl'}>
      {lede && <p class={`max-w-prose text-lg text-tone-fg ${aside ? '' : 'mx-auto mt-5'}`}>{lede}</p>}
      <slot />
    </div>
  </div>
</section>
