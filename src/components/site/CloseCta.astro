---
import AddressForm from './AddressForm.astro';
export interface Props { title?: string; lede?: string; source?: string; city?: string; service?: string }
const { title = 'Never pick up after your dog again.', lede = 'See your price in a minute. Your first month is half off.', source = 'close', city, service } = Astro.props;
---
<section class="bg-forest-800 py-section-sm">
  <div class="container-site grid items-center gap-8 lg:grid-cols-2">
    <div>
      <h2 class="text-h2 text-white">{title}</h2>
      <p class="mt-3 text-lg text-forest-200">{lede}</p>
    </div>
    <AddressForm dark size="md" label="Your address" source={source} city={city} service={service} />
  </div>
</section>
