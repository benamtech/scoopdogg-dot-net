---
/**
 * The last band on a page: the orange surface, white display text, the address form on its
 * white card, and the mascot. On orange only large text may be white (3.15:1), so the lede is
 * statement size and the form's label is visually hidden — the heading asks the question.
 * `tone="forest"` is there for a page whose previous band is already orange.
 */
import { Image } from 'astro:assets';
import AddressForm from './AddressForm.astro';
import mascot from '../../assets/art/dog-jumping.png';
import { headlineOffer } from '../../lib/catalog';
export interface Props { title?: string; lede?: string; source?: string; city?: string; service?: string; tone?: 'orange' | 'forest' }
const { title = 'Never pick up after your dog again.', lede = `See your price in a minute.${headlineOffer ? ` ${headlineOffer.name}.` : ''}`, source = 'close', city, service, tone = 'orange' } = Astro.props;
---
<section class={`tone-${tone} relative overflow-hidden bg-tone-bg`} aria-labelledby={`${source}-title`}>
  <div class="container-site relative grid items-center gap-10 py-section-sm lg:grid-cols-12 lg:py-16">
    <div class="lg:col-span-8">
      <h2 id={`${source}-title`} class="max-w-2xl text-h1 text-white">{title}</h2>
      <p class="mt-4 max-w-2xl text-statement text-white">{lede}</p>
      <div class="mt-8 max-w-xl"><AddressForm size="md" label="Your street address" hideLabel source={source} city={city} service={service} /></div>
    </div>
    <div class="pointer-events-none hidden justify-center lg:col-span-4 lg:flex" aria-hidden="true">
      <Image src={mascot} alt="" widths={[280, 560]} sizes="280px" class="h-auto w-52 -rotate-3 drop-shadow-xl xl:w-60" loading="lazy" />
    </div>
  </div>
</section>
