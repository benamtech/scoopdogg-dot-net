---
/**
 * A band of the page. The tone is the surface (src/index.css): `white` is the default and most
 * of the site, `forest` carries white text at any size, `orange` carries white text only at
 * large sizes — small text on orange goes on a white card. Two white bands in a row get a
 * hairline between them (`rule`), so a page never blurs into one long sheet.
 *
 * Legacy tone names map onto the three surfaces so older pages keep rendering.
 */
export interface Props {
  tone?: 'white' | 'forest' | 'orange' | 'tint' | 'deep' | 'paper' | 'cream' | 'sand' | 'forest-deep';
  size?: 'lg' | 'md' | 'sm' | 'none';
  id?: string;
  class?: string;
  labelledby?: string;
  rule?: boolean;
  bleed?: boolean;
}
const { tone = 'white', size = 'md', id, class: extra = '', labelledby, rule = false, bleed = false } = Astro.props;
const surface = ({ paper: 'white', cream: 'white', sand: 'tint', 'forest-deep': 'deep' } as Record<string, string>)[tone] ?? tone;
const pad = { lg: 'py-section', md: 'py-section', sm: 'py-section-sm', none: '' }[size];
---
<section
  id={id}
  aria-labelledby={labelledby}
  class={`tone-${surface} relative bg-tone-bg text-tone-fg ${pad} ${rule ? 'border-t border-tone-rule' : ''} ${extra}`}
  data-tone={surface}
>
  {bleed ? <slot /> : <div class="container-site relative"><slot /></div>}
</section>
