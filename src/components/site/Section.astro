---
/**
 * A band of the page. The tone is the surface (src/index.css): `forest` carries white text at
 * any size, `orange` carries white text only at large sizes — small text on orange goes on a
 * white card. Two bands sharing a tone get a hairline between them (`rule`), so a page never
 * blurs into one long sheet.
 *
 * `cream` AND `sand` ARE REAL SURFACES NOW. They used to be aliases: `cream` mapped to white
 * and `sand` to tint, which is why P15 §5 records Ben asking to *"avoid the basic, all white
 * background"* about a site whose pages were already asking for cream and being given white.
 * A component that silently answers a different question than the one it was asked is worse
 * than one that refuses. Only `paper` and `forest-deep` remain aliases, and both are exact
 * synonyms rather than substitutions.
 */
export interface Props {
  tone?: 'white' | 'cream' | 'sand' | 'forest' | 'orange' | 'tint' | 'photo' | 'deep' | 'paper' | 'forest-deep';
  size?: 'lg' | 'md' | 'sm' | 'none';
  id?: string;
  class?: string;
  labelledby?: string;
  rule?: boolean;
  bleed?: boolean;
}
const { tone = 'white', size = 'md', id, class: extra = '', labelledby, rule = false, bleed = false } = Astro.props;
const surface = ({ paper: 'white', 'forest-deep': 'deep' } as Record<string, string>)[tone] ?? tone;
const pad = { lg: 'py-section', md: 'py-section', sm: 'py-section-sm', none: '' }[size];
---
<section
  id={id}
  aria-labelledby={labelledby}
  class={`tone-${surface} relative bg-tone-bg text-tone-fg ${pad} ${rule ? 'border-t border-tone-rule' : ''} ${extra}`}
  data-tone={surface}
>
  {bleed ? <slot /> : <div class="container-site relative"><slot /></div>}
</section>
