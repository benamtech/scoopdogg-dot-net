---
/**
 * "Tell Josue about the job" — the custom-quote request (server/lib/quotes.ts, R21).
 *
 * THE ORDER IS THE DESIGN. The problem first (Rackham: the questions that win bigger work are about
 * the customer's problem, not their budget), then photos (they let him price without a visit), then
 * when, then who. About seven fields a person types; the rest are taps. No ZIP gate — a particular
 * job is worth hearing about from anywhere.
 *
 * WHAT HAPPENS AFTER SEND IS THE OTHER HALF (Maister: an explained, finite wait is a short one). The
 * confirmation says who reads it, by when, what happens next, and gives them a link that shows
 * where it is.
 *
 * PROGRESSIVE. Without JavaScript the form cannot submit (photos need resizing in the browser), so
 * it says so and gives the phone number. Plain inputs read at submit time, so nothing typed before
 * the script runs is lost.
 */
import { business, setting } from '../../lib/catalog';
import { JOB_KINDS } from '../../shared/quote-contract';
export interface Props { service?: string }
const reply = setting<string>('quote.reply_promise', 'within one business day');
const maxPhotos = setting<number>('quote.photos_max', 6);
---
<form id="custom-quote" class="tone-white rounded-xl bg-paper p-6 shadow-lg ring-1 ring-black/5 sm:p-8" data-quote-request data-max-photos={maxPhotos} novalidate>
  <h2 class="text-h3 text-forest-900">Tell Josue about the job</h2>
  <p class="mt-2 text-base text-ink-500">Free, and no obligation. He reads every request himself and replies {reply}.</p>

  <fieldset class="mt-7">
    <legend class="field-label">What needs doing? Tick any that fit.</legend>
    <div class="mt-3 grid gap-2 sm:grid-cols-2">
      {JOB_KINDS.map((k) => (
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-line p-3 text-base text-ink-700 has-[:checked]:border-forest-600 has-[:checked]:bg-forest-50">
          <input type="checkbox" name="job_kinds" value={k.id} class="mt-1 h-5 w-5 accent-forest-700" />
          <span>{k.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="mt-6">
    <label class="field-label" for="cq-description">Tell him about it</label>
    <textarea id="cq-description" name="description" class="field min-h-[140px]" placeholder="For example: the back yard is about 1,500 sq ft and overgrown. I'd like it cleared, weeded and the green waste hauled away. What would 'done' look like for you?"></textarea>
  </div>

  <div class="mt-6">
    <p class="field-label">Photos <span class="font-normal text-ink-500">(they let Josue price it without a visit)</span></p>
    <label class="mt-2 flex cursor-pointer items-center justify-center gap-3 rounded-lg border-2 border-dashed border-line-strong p-5 text-base font-medium text-forest-800 hover:border-forest-400">
      <input type="file" name="photos" accept="image/*" multiple class="sr-only" data-photo-input />
      <span>Add photos (up to {maxPhotos})</span>
    </label>
    <div class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-6" data-photo-previews></div>
  </div>

  <fieldset class="mt-6">
    <legend class="field-label">When?</legend>
    <div class="mt-2 flex flex-wrap gap-2">
      {[['asap', 'As soon as possible'], ['month', 'Within a month'], ['flexible', "I'm flexible"]].map(([v, l]) => (
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-line px-4 py-3 text-base has-[:checked]:border-forest-600 has-[:checked]:bg-forest-50">
          <input type="radio" name="timing" value={v} class="h-5 w-5 accent-forest-700" /> {l}
        </label>
      ))}
    </div>
  </fieldset>

  <div class="mt-7 grid gap-5 sm:grid-cols-2">
    <div><label class="field-label" for="cq-name">Your name</label><input class="field" id="cq-name" name="name" autocomplete="name" required /></div>
    <div><label class="field-label" for="cq-phone">Mobile</label><input class="field" id="cq-phone" name="phone" type="tel" autocomplete="tel" required /></div>
    <div class="sm:col-span-2"><label class="field-label" for="cq-email">Email</label><input class="field" id="cq-email" name="email" type="email" autocomplete="email" required /></div>
    <div><label class="field-label" for="cq-address">Street address of the job</label><input class="field" id="cq-address" name="address" autocomplete="street-address" /></div>
    <div><label class="field-label" for="cq-city">City or ZIP</label><input class="field" id="cq-city" name="city" autocomplete="address-level2" required /></div>
  </div>

  <fieldset class="mt-6">
    <legend class="field-label">Best way to reach you</legend>
    <div class="mt-2 flex flex-wrap gap-2">
      {[['text', 'Text'], ['call', 'Call'], ['email', 'Email']].map(([v, l], i) => (
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-line px-4 py-3 text-base has-[:checked]:border-forest-600 has-[:checked]:bg-forest-50">
          <input type="radio" name="contact_pref" value={v} checked={i === 0} class="h-5 w-5 accent-forest-700" /> {l}
        </label>
      ))}
    </div>
  </fieldset>

  <input type="hidden" name="service_slug" value={Astro.props.service ?? ''} data-service />
  <p class="mt-5 hidden rounded-md bg-danger-100 px-3 py-2 text-sm text-danger" data-error role="alert"></p>
  <p class="mt-5 hidden text-base text-ink-700" data-progress aria-live="polite"></p>
  <button type="submit" class="btn-primary mt-6 w-full sm:w-auto" data-submit>Send to Josue</button>
  <noscript><p class="mt-3 text-sm text-ink-700">This form needs JavaScript for the photos. Call or text <a class="link" href={business.phoneHref}>{business.phone}</a> instead.</p></noscript>
</form>

<div class="tone-white hidden rounded-xl bg-paper p-8 shadow-lg ring-1 ring-black/5" data-quote-request-done>
  <p class="text-h3 text-forest-900">Josue has it.</p>
  <p class="mt-3 text-base text-ink-700">He reads every request himself and will reply {reply}, usually by text from {business.phone}. A copy is on its way to your email.</p>
  <ol class="mt-5 space-y-2 text-base text-ink-700">
    <li><strong>1.</strong> He looks at your photos, and may ask a question or stop by for a quick look.</li>
    <li><strong>2.</strong> He sends you a quote: every line itemised, and any extras you can add.</li>
    <li><strong>3.</strong> You approve it online and pay a deposit to book. The rest is paid when the work is done.</li>
  </ol>
  <p class="mt-6 text-base text-ink-700">See where it is any time: <a class="link break-all" href="#" data-status-link></a></p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-quote-request]');
  if (form) {
    const max = Number(form.dataset.maxPhotos || 6);
    const input = form.querySelector<HTMLInputElement>('[data-photo-input]')!;
    const previews = form.querySelector<HTMLElement>('[data-photo-previews]')!;
    const err = form.querySelector<HTMLElement>('[data-error]')!;
    const progress = form.querySelector<HTMLElement>('[data-progress]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const service = new URLSearchParams(location.search).get('service');
    if (service) form.querySelector<HTMLInputElement>('[data-service]')!.value = service;
    let photos: File[] = [];

    const draw = () => {
      previews.replaceChildren(...photos.map((f, i) => {
        const wrap = document.createElement('div');
        wrap.className = 'relative';
        const img = document.createElement('img');
        img.src = URL.createObjectURL(f);
        img.alt = `Photo ${i + 1}`;
        img.className = 'aspect-square w-full rounded-lg object-cover';
        const x = document.createElement('button');
        x.type = 'button';
        x.textContent = '×';
        x.setAttribute('aria-label', `Remove photo ${i + 1}`);
        x.className = 'absolute right-1 top-1 h-7 w-7 rounded-full bg-black/70 text-white';
        x.onclick = () => { photos.splice(i, 1); draw(); };
        wrap.append(img, x);
        return wrap;
      }));
    };
    input.addEventListener('change', () => {
      photos = [...photos, ...Array.from(input.files ?? [])].slice(0, max);
      input.value = '';
      draw();
    });

    /** A phone photo is 3-5MB; the server takes under 900KB. Resize in the browser, as the crew app does. */
    const shrink = async (file: File): Promise<string> => {
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bmp.width * scale);
      canvas.height = Math.round(bmp.height * scale);
      canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
      for (const q of [0.82, 0.7, 0.55]) {
        const url = canvas.toDataURL('image/jpeg', q);
        if (url.length * 0.75 < 850_000) return url;
      }
      return canvas.toDataURL('image/jpeg', 0.45);
    };
    const post = async (path: string, body: unknown) => {
      const r = await fetch(`/api/quote/${path}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.error || 'Something went wrong. Please call or text us.');
      return j;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      const fd = new FormData(form);
      const body = {
        name: String(fd.get('name') ?? ''), phone: String(fd.get('phone') ?? ''), email: String(fd.get('email') ?? ''),
        address: String(fd.get('address') ?? ''), city: String(fd.get('city') ?? ''),
        description: String(fd.get('description') ?? ''), job_kinds: fd.getAll('job_kinds').map(String),
        timing: fd.get('timing'), contact_pref: fd.get('contact_pref'), service_slug: String(fd.get('service_slug') ?? ''),
        source_page: location.pathname + location.search, photos_expected: photos.length,
      };
      if (!body.name || !body.phone || !body.email) { err.textContent = 'Please give your name, mobile and email so Josue can reach you.'; err.classList.remove('hidden'); return; }
      if (!body.description && body.job_kinds.length === 0) { err.textContent = 'Tick what needs doing, or tell Josue about it in a sentence.'; err.classList.remove('hidden'); return; }
      submit.disabled = true;
      try {
        progress.textContent = 'Sending…';
        progress.classList.remove('hidden');
        const { token } = await post('request', body);
        let sent = 0; let failed = 0;
        for (const f of photos) {
          progress.textContent = `Uploading photo ${sent + failed + 1} of ${photos.length}…`;
          try { await post('photo', { token, data_url: await shrink(f) }); sent++; } catch { failed++; }
        }
        await post('done', { token }).catch(() => {});
        const done = document.querySelector<HTMLElement>('[data-quote-request-done]')!;
        const link = done.querySelector<HTMLAnchorElement>('[data-status-link]')!;
        link.href = `/quote/${token}`;
        link.textContent = `${location.origin}/quote/${token}`;
        if (failed) done.insertAdjacentHTML('beforeend', `<p class="mt-4 text-base text-ink-700">${failed} photo${failed === 1 ? '' : 's'} did not upload. You can text them to Josue instead.</p>`);
        form.classList.add('hidden');
        done.classList.remove('hidden');
        done.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (x) {
        err.textContent = (x as Error).message;
        err.classList.remove('hidden');
        progress.classList.add('hidden');
        submit.disabled = false;
      }
    });
  }
</script>
