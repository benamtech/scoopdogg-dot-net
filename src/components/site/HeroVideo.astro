---
/**
 * The hero Josue's customers compliment, with the funnel's first question inside it.
 *
 * P15 §1 and §4. The live site opens with a full-bleed `hero.mp4`, a dark overlay, a DM Serif
 * Display headline with an orange accent, and two pill buttons. All of that comes back. What
 * changes is that the second CTA becomes the ZIP field, the from-price resolves from a row, and
 * the video costs nothing at first paint.
 *
 * ── THE VIDEO, ENGINEERED RATHER THAN DROPPED ──────────────────────────────────────────────
 *
 * R6 §A1 banned it on speed evidence. Josue gets comments on it and Ben settled that it stays.
 * Both are true, so the cost comes out of the engineering:
 *
 *  1. THE POSTER IS THE LCP ELEMENT, not the video. It is `<link rel=preload as=image>` with
 *     `fetchpriority=high` in the page head and rendered as a real `<img>` underneath — the
 *     Web Almanac finds images are the LCP element on 76% of mobile pages, so the only real
 *     question is WHICH image, and this is the answer.
 *  2. `preload="none"` and NO `<source>` in the markup. A source element is a download
 *     instruction; the browser obeys it before it has painted anything.
 *  3. The source is attached on `requestIdleCallback`, or on the first pointer or scroll,
 *     whichever comes first. So the video arrives after the page is usable, never before.
 *  4. `prefers-reduced-motion: reduce` → the poster, permanently. No listener, no fetch.
 *  5. Save-Data, or an effectiveType below 4g → the poster. A hero video on a metered
 *     connection is somebody else's money.
 *  6. A REAL PAUSE BUTTON. WCAG 2.2.2 (Level A): motion that starts automatically and runs for
 *     more than five seconds must be pausable, stoppable or hideable by a mechanism the user
 *     can operate. A looping hero video is exactly that, and `prefers-reduced-motion` does not
 *     satisfy it — it serves the people who have set the preference and nobody else.
 *     P15 §4 listed five rules; this is the sixth, and it is the one Lighthouse cannot see.
 *     The recorded "accessibility 100" was measured on a page with no video on it.
 *
 * The number this has to hold: Lighthouse mobile median-of-3 ≥ 90, accessibility 100. If it
 * cannot hold with autoplay, the hero becomes tap-to-play behind the poster — which is what the
 * published A/B material prefers anyway (R10 §3), so that is a result and not a retreat.
 */
import { Image } from 'astro:assets';
import AddressForm from './AddressForm.astro';
import Stars from './Stars.astro';
// THE POSTER GOES THROUGH astro:assets LIKE EVERY OTHER IMAGE.
//
// It was a raw `/public/video/hero-poster.jpg`: 1280x720, 89KB, one size for every device.
// Measured 2026-09-19 on the first Lighthouse run after the port — it IS the LCP element, which
// is what P15 §4 wanted, and it had pushed the homepage's LCP from 1808ms to ~2338ms. Lighthouse
// named both reasons: `uses-responsive-images` 43 KiB (a 1280px file on a 390px screen) and
// `modern-image-formats` 22 KiB (JPEG, not WebP). P15 §4's own budget is 45KB and it was at 89.
//
// This is exactly the defect P15 §3 names about the live site's full-size PNGs, in the one
// place it hurts most.
import heroPoster from '../../assets/video/hero-poster.jpg';

export interface Props {
  /** The resolved from-price in cents. Never typed — `gates/no-price-in-prose.mjs`. */
  fromCents: number | null;
  perVisitCents: number | null;
  serviceRegion: string;
  phone: string;
  phoneHref: string;
  rating: number | null;
  /** `reviews.google_count` — Josue's real total. NULL until he enters it in the admin. */
  reviewCount: number | null;
  /** How many review quotes we actually hold and can show. Always true, never a claim. */
  quoteCount: number;
  /** The half-off line, or whatever `offers` currently says. Null renders nothing. */
  offer: string | null;
}
const { fromCents, perVisitCents, serviceRegion, phone, phoneHref, rating, reviewCount, quoteCount, offer } = Astro.props;
const money = (c: number) => `$${(c / 100).toFixed(c % 100 ? 2 : 0)}`;
---
{/*
  THE POSTER'S PRELOAD LIVES IN index.astro, NOT HERE. Astro's `slot="head"` reaches the layout
  only from the page itself; a nested component cannot push into the head two levels up, and a
  `<link rel=preload>` emitted in the body is read too late to be worth anything. index.astro
  passes it through Site.astro's head slot, right beside the page that uses it.
*/}
<section class="tone-photo relative isolate overflow-hidden bg-forest-800" data-hero-video>
  {/* THE VIDEO IS UNDERNEATH, AND THE POSTER FADES OUT — not the other way round.
      The first version started the video at `opacity-0` and revealed it on `playing`, which
      `gates/build-gates.mjs` correctly failed: content at opacity-0 in the static HTML is
      content a visitor without JavaScript never sees, and that gate exists because this whole
      site was once invisible without it. Painting the poster OVER the video and fading the
      poster instead means the built HTML has nothing hidden in it at all. No <source>: the
      script attaches one, later, if it should. */}
  <video
    data-hero-player
    data-src="/video/hero.mp4"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
  ></video>

  {/* THE LCP ELEMENT. A real <img>, eager, high priority, never lazy — the Almanac's 16–17% of
      pages that lazy-load their own LCP image are making the one mistake that cannot be undone
      later in the waterfall. It sits after the video, so it paints on top of it. */}
  <Image
    data-hero-poster
    src={heroPoster}
    alt=""
    aria-hidden="true"
    widths={[390, 640, 960, 1280]}
    sizes="100vw"
    format="webp"
    quality={62}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-center transition-opacity duration-700"
  />

  {/* The live site's two overlays, which are what makes white type legible over a moving image. */}
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-forest-900/70 via-forest-900/55 to-forest-900/75" aria-hidden="true"></div>

  <div class="container-site relative grid items-center gap-10 pb-16 pt-14 lg:min-h-[78vh] lg:grid-cols-12 lg:pb-24 lg:pt-20">
    <div class="lg:col-span-7">
      <p class="mb-5 text-sm font-semibold uppercase tracking-[0.14em] text-amber-400">Pooper scoopers · {serviceRegion}</p>

      {/* Josue's headline, verbatim, with his orange accent. */}
      {/* `text-hero` is the scale's own clamp (2.625rem → 5.25rem), so this one headline does
          not need three breakpoint sizes and cannot drift off the scale. The live page's
          5xl/6xl/7xl steps land inside the same range. */}
      <h1 class="font-serif text-hero text-white">
        Dog Poop Cleaning Services in <em class="not-italic text-amber-400">Ventura County</em>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-forest-100 sm:text-xl">
        Same day every week. Scooped, bagged and hauled away{fromCents && <> — from <strong class="font-semibold text-white">{money(fromCents)} a month</strong></>}{perVisitCents && <>, about {money(perVisitCents)} a visit</>}.
        {offer && <> {offer}.</>} No contract.
      </p>

      {/* THE SECOND CTA BECOMES THE FUNNEL (P15 §2 row 1). One field, a plain GET to /book, so
          it answers before any JavaScript has loaded. The phone is the secondary action. */}
      <div class="mt-9"><AddressForm heroAnchor source="home-hero" label="Where's your yard?" /></div>

      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3 text-base text-forest-100">
        {rating && (
          <a href="/reviews" class="inline-flex items-center gap-2 text-forest-100 hover:text-white">
            <Stars rating={rating} size={16} />
            {/* ONE COUNT, FROM ONE ROW. "18 Google reviews" was 18 quotes we hold, not 18
                reviews Josue has — the live page said 19 in one place and 27 in another while
                the database held 18, and this is the same overclaim in the loudest position on
                the site. Until `reviews.google_count` is filled in the admin, the page says
                what it can prove. */}
            <span><strong class="font-semibold text-white">{rating.toFixed(1)}</strong> · {reviewCount ? `${reviewCount} Google reviews` : `${quoteCount} reviews`}</span>
          </a>
        )}
        <a href={phoneHref} class="inline-flex items-center gap-2 rounded-full border border-white/35 px-5 py-2.5 font-medium text-white transition hover:bg-white/10">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z" /></svg>
          {phone}
        </a>
      </div>
    </div>
  </div>

  {/* WCAG 2.2.2. Hidden until the video is actually playing, because a pause button over a
      still poster is a control for nothing. It is a real <button>: focusable, labelled, and its
      label says what it will do next. */}
  <button
    type="button"
    data-hero-toggle
    hidden
    class="absolute bottom-4 right-4 z-10 inline-flex items-center gap-2 rounded-full border border-white/40 bg-forest-900/70 px-4 py-2 text-sm font-medium text-white backdrop-blur transition hover:bg-forest-900/90 focus-visible:shadow-focus"
  >
    <svg data-icon-pause width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
    <svg data-icon-play class="hidden" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
    <span data-hero-toggle-label>Pause background video</span>
  </button>
</section>

<script>
  // Everything here is progressive: with this script removed the page is a poster, a headline
  // and a working form. That is the test for whether the video is really optional.
  const section = document.querySelector('[data-hero-video]');
  const video = section?.querySelector('[data-hero-player]') as HTMLVideoElement | null;
  const toggle = section?.querySelector('[data-hero-toggle]') as HTMLButtonElement | null;
  const label = toggle?.querySelector('[data-hero-toggle-label]');
  const iconPause = toggle?.querySelector('[data-icon-pause]') as SVGElement | null;
  const iconPlay = toggle?.querySelector('[data-icon-play]') as SVGElement | null;

  if (video && toggle) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // `connection` is not in every browser's lib.dom; absence means "assume a good connection",
    // which is the same assumption as not checking at all.
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const thin = Boolean(conn?.saveData) || ['slow-2g', '2g', '3g'].includes(conn?.effectiveType ?? '');

    const setLabel = (paused: boolean) => {
      if (label) label.textContent = paused ? 'Play background video' : 'Pause background video';
      // A class, not the `hidden` attribute: Astro types `<svg>` as SVGAttributes, which has
      // no `hidden`, so the initial state has to be a class and the toggle has to match it.
      iconPause?.classList.toggle('hidden', paused);
      iconPlay?.classList.toggle('hidden', !paused);
    };

    toggle.addEventListener('click', () => {
      if (video.paused) { void video.play(); setLabel(false); }
      else { video.pause(); setLabel(true); }
    });

    const start = () => {
      if (video.dataset.started) return;
      video.dataset.started = '1';
      const source = document.createElement('source');
      source.src = video.dataset.src!;
      source.type = 'video/mp4';
      video.appendChild(source);
      video.load();
      video.addEventListener('playing', () => {
        // The poster steps aside; the video was always there, underneath.
        section?.querySelector('[data-hero-poster]')?.classList.add('opacity-0');
        // The control appears only once there is motion to stop.
        toggle.hidden = false;
        setLabel(false);
      }, { once: true });
      void video.play().catch(() => {
        // Autoplay refused (some iOS settings, some data savers). The poster stays and there is
        // nothing to pause, so the button stays hidden rather than lying about what it does.
        video.dataset.started = '';
      });
    };

    if (!reduced && !thin) {
      // After the page is usable, or the moment the visitor shows any intent — whichever is
      // first. Never before first paint.
      const idle = (window as Window & { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void }).requestIdleCallback;
      if (idle) idle(start, { timeout: 3000 });
      else setTimeout(start, 1200);
      addEventListener('pointerdown', start, { once: true, passive: true });
      addEventListener('scroll', start, { once: true, passive: true });
    }
  }
</script>
