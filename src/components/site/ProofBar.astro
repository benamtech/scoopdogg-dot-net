---
/**
 * A slim green band of operational proof straight after a hero: the review score with its
 * count, insured and checked, the same day every week, cancel from your account. Each item is
 * conditional on the row or setting that makes it true (S19, S20).
 */
import { reviewSummary, trust } from '../../lib/catalog';
const items = [
  reviewSummary.rating ? { icon: 'star', strong: `${reviewSummary.rating.toFixed(1)} on Google`, rest: `${reviewSummary.count} reviews` } : null,
  trust.insured && trust.backgroundChecked ? { icon: 'shield', strong: 'Insured', rest: 'and background-checked' } : trust.insured ? { icon: 'shield', strong: 'Fully insured', rest: '' } : null,
  { icon: 'calendar', strong: 'Same day', rest: 'every week' },
  { icon: 'x', strong: 'Cancel anytime', rest: 'from your account' },
].filter(Boolean) as { icon: string; strong: string; rest: string }[];
const paths: Record<string, string> = {
  star: 'M12 2.5l2.9 5.9 6.6 1-4.8 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5-4.8-4.6 6.6-1L12 2.5z',
  shield: 'M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3Zm-3.5 9l2.5 2.5 4.5-5',
  calendar: 'M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm3 9l2.5 2.5L16 11',
  x: 'M5 12l5 5 9-10',
};
---
<section class="tone-forest bg-tone-bg" aria-label="Why customers choose Scoop Dogg">
  <ul class="container-site grid grid-cols-2 gap-x-4 gap-y-4 py-6 lg:grid-cols-4 lg:py-7">
    {items.map((it) => (
      <li class="flex items-center gap-3 text-sm leading-snug text-tone-fg sm:text-base">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-amber-400" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill={it.icon === 'star' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width={it.icon === 'star' ? 0 : 2.25} stroke-linecap="round" stroke-linejoin="round"><path d={paths[it.icon]} /></svg>
        </span>
        <span><strong class="font-semibold text-white">{it.strong}</strong>{it.rest ? ` ${it.rest}` : ''}</span>
      </li>
    ))}
  </ul>
</section>
