---
/**
 * A guide. Rebuilt from the React ArticlePage on the section library (loop 2 item 5): static
 * HTML, zero framework JavaScript, the short answer first (R6 §C3: one question, one direct
 * answer in the first sentence), and the price one field away in the sidebar.
 *
 * Images from other businesses (a London garden builder, a Sunnyvale turf installer) are not
 * rendered: they are not Scoop Dogg's, and readers ignore stock photos (R6 §A2).
 */
import Site from '../../layouts/Site.astro';
import Section from '../../components/site/Section.astro';
import AddressForm from '../../components/site/AddressForm.astro';
import Faq from '../../components/site/Faq.astro';
import CloseCta from '../../components/site/CloseCta.astro';
import { ARTICLES } from '../../lib/articles';
import { SITE_URL } from '../../lib/constants';
import { headlineOffer } from '../../lib/catalog';

export function getStaticPaths() {
  return ARTICLES.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const NOT_OURS = ['/period-property-wandsworth', '/artificial-grass-installed-sunnyvale', '/Artificial-Grass-for-Dogs-Runs-Pet-Areas'];
const ours = (src?: string) => !!src && !NOT_OURS.some((p) => src.startsWith(p));
const fmt = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const others = ARTICLES.filter((x) => x.slug !== a.slug).slice(0, 3);
// Three guides carry no openingAnswer; their excerpt is already a direct answer, so it moves into the answer box.
const answer = a.openingAnswer || a.excerpt;
const longTitle = a.title.length > 60;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: a.title, description: a.metaDescription,
    datePublished: a.publishedDate, dateModified: a.updatedDate || a.publishedDate,
    author: { '@type': 'Organization', name: 'Scoop Dogg', url: SITE_URL },
    publisher: { '@type': 'Organization', name: 'Scoop Dogg', '@id': `${SITE_URL}/#business` },
    mainEntityOfPage: `${SITE_URL}/resources/${a.slug}`,
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE_URL}/resources` },
      { '@type': 'ListItem', position: 3, name: a.title, item: `${SITE_URL}/resources/${a.slug}` },
    ],
  },
  ...(a.faqs?.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: a.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Site title={a.metaTitle} description={a.metaDescription} canonicalPath={`/resources/${a.slug}`} jsonLd={jsonLd}>
  <section class="tone-forest bg-tone-bg">
    <div class="container-site py-12 lg:py-20">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-tone-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-white hover:underline">Home</a></li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="opacity-60">/</span><a href="/resources" class="hover:text-white hover:underline">Guides</a></li>
        </ol>
      </nav>
      <p class="eyebrow mb-5">Guide · {a.readTime}</p>
      <h1 class={`max-w-4xl text-white ${longTitle ? 'text-h2' : 'text-h1'}`}>{a.title}</h1>
      {a.openingAnswer && <p class="mt-6 max-w-prose text-lg text-tone-fg">{a.excerpt}</p>}
      <p class="mt-6 text-sm text-tone-muted">Updated {fmt(a.updatedDate || a.publishedDate)} · By Scoop Dogg</p>
    </div>
  </section>

  <Section tone="white">
    <div class="grid gap-12 lg:grid-cols-12">
      <article class="min-w-0 lg:col-span-8">
        <div class="tone-tint rounded-xl border-l-4 border-orange-600 bg-tone-bg p-6 sm:p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.1em] text-forest-700">The short answer</p>
          <p class="mt-3 text-xl leading-relaxed text-forest-900" data-speakable>{answer}</p>
        </div>

        <div class="prose-sd mt-4">
          {a.sections.map((s) => (
            <section id={s.id} aria-labelledby={`${s.id}-h`}>
              <h2 id={`${s.id}-h`}>{s.heading}</h2>
              {s.paragraphs.map((p) => <p>{p}</p>)}
              {s.bullets && <ul>{s.bullets.map((b) => <li>{b}</li>)}</ul>}
              {s.numberedSteps && <ol>{s.numberedSteps.map((b) => <li>{b}</li>)}</ol>}
              {s.callout && <blockquote>{s.callout.text}{s.callout.source && <span class="mt-2 block font-sans text-sm text-ink-500">— {s.callout.source}</span>}</blockquote>}
              {s.table && (
                <div class="overflow-x-auto">
                  <table><thead><tr><th>Question</th><th>Answer</th></tr></thead>
                    <tbody>{s.table.map((r) => <tr><td>{r.question}</td><td>{r.answer}</td></tr>)}</tbody>
                  </table>
                </div>
              )}
              {s.subsections && s.subsections.map((sub) => (<><h3>{sub.heading}</h3>{sub.paragraphs.map((p) => <p>{p}</p>)}</>))}
              {ours(s.image?.src) && <img src={s.image!.src} alt={s.image!.alt} loading="lazy" class="mx-auto my-8 h-auto max-h-80 w-auto" />}
              {s.internalLinks && s.internalLinks.length > 0 && (
                <p class="flex flex-wrap gap-2">
                  {s.internalLinks.map((l) => <a href={l.to} class="chip inline-flex items-center gap-1.5 rounded-full border border-line-strong px-4 py-2 text-sm font-medium text-forest-800 no-underline hover:border-forest-500 hover:bg-forest-50">{l.label} →</a>)}
                </p>
              )}
            </section>
          ))}
        </div>

        {a.faqs?.length > 0 && (
          <div class="mt-16">
            <h2 class="text-h2 text-forest-900">Questions</h2>
            <div class="mt-8"><Faq items={a.faqs} openFirst={false} /></div>
          </div>
        )}

        {a.sources && a.sources.length > 0 && (
          <div class="mt-12 border-t border-line pt-8">
            <p class="text-sm font-semibold uppercase tracking-[0.1em] text-ink-500">Sources</p>
            <ol class="mt-4 space-y-2 text-base">
              {a.sources.map((src) => <li class="flex gap-3"><span class="font-mono text-sm text-ink-500">[{src.id}]</span><a href={src.url} rel="noopener" class="link">{src.label}</a></li>)}
            </ol>
          </div>
        )}
      </article>

      <aside class="lg:col-span-4">
        <div class="space-y-5 lg:sticky lg:top-28">
          <div class="tone-forest rounded-xl bg-tone-bg p-7">
            <p class="font-serif text-h3 text-white">Rather not do it yourself?</p>
            <p class="mt-2 text-base text-tone-fg">Weekly scooping, same day every week.{headlineOffer ? ` ${headlineOffer.name}.` : ''}</p>
            <div class="mt-5"><AddressForm size="md" stack label="Your address" source={`guide-${a.slug}`} /></div>
          </div>
          <nav aria-label="In this guide" class="hidden rounded-xl border border-line p-6 lg:block">
            <p class="text-sm font-semibold uppercase tracking-[0.1em] text-ink-500">In this guide</p>
            <ol class="mt-4 space-y-2.5 text-base">
              {a.sections.map((s) => <li><a href={`#${s.id}`} class="text-forest-800 hover:text-forest-600 hover:underline">{s.heading}</a></li>)}
            </ol>
          </nav>
        </div>
      </aside>
    </div>
  </Section>

  {others.length > 0 && (
    <Section tone="white" size="sm" rule labelledby="more-guides">
      <h2 id="more-guides" class="text-h3 text-forest-900">More guides</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {others.map((o) => <li><a href={`/resources/${o.slug}`} class="card-lift block h-full p-6"><span class="block text-lg font-semibold text-forest-900">{o.title}</span><span class="mt-2 block text-sm text-ink-500">{o.readTime}</span></a></li>)}
      </ul>
    </Section>
  )}
  <CloseCta source={`guide-${a.slug}-close`} />
</Site>
