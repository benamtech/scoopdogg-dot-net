---
/** Commercial work (R5 §8: on 86% of scooper sites). Hero on the brand green -> who it is for and the quote form (white). */
import Site from '../layouts/Site.astro';
import PageHero from '../components/site/PageHero.astro';
import Section from '../components/site/Section.astro';
import InquiryForm from '../components/site/InquiryForm.astro';
import { regionSentence } from '../lib/catalog';
const points = [
  { t: 'HOAs and common areas', d: 'Greenbelts, walking paths and dog areas kept clean on a set weekly schedule.' },
  { t: 'Apartments and rentals', d: 'Dog runs, courtyards and pet relief areas serviced before residents notice.' },
  { t: 'Property managers', d: 'One point of contact and one monthly invoice across your properties.' },
  { t: 'Pet businesses', d: 'Daycares, boarding and training yards with heavier, more frequent use.' },
];
---
<Site title="Commercial Pet Waste Removal | HOAs & Apartments | Scoop Dogg" description={`Pet waste removal for HOAs, apartment communities and property managers across ${regionSentence()}.`} canonicalPath="/commercial">
  <PageHero tone="forest" eyebrow="Commercial" title="Pet waste handled for your whole community" lede="HOAs, apartment communities and property managers: a set weekly schedule, one invoice, and grounds residents actually notice." />
  <Section tone="sand">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow mb-4">Who it is for</p>
        <h2 class="text-h2 text-forest-900">Built for properties</h2>
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {points.map((p) => <div class="border-t-2 border-orange-600 pt-5"><h3 class="font-sans text-xl font-semibold text-forest-900">{p.t}</h3><p class="mt-2 text-base text-ink-700">{p.d}</p></div>)}
        </div>
      </div>
      <div class="lg:col-span-6">
        <InquiryForm title="Get a property quote" lede="Tell us about the property. We reply within one business day." subject="Commercial quote" cta="Request a quote" fields={[{ name: 'property', label: 'Property name and address', required: true }, { name: 'details', label: 'Number of units or areas, and how often you need service', textarea: true }]} />
      </div>
    </div>
  </Section>
</Site>
