---
import Site from '../layouts/Site.astro';
import { SITE_URL } from '../lib/constants';
import Page from '../pages_react/GalleryPage';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Scoop Dogg Gallery',
  about: { '@type': 'LocalBusiness', '@id': `${SITE_URL}/#business`, name: 'Scoop Dogg' },
};
---
<Site jsonLd={jsonLd} title={'Gallery | Scoop Dogg Before and After'} description={'Yards, turf and dog runs across Ventura County, before and after a Scoop Dogg visit.'} canonicalPath="/gallery">
  <Page />
</Site>
