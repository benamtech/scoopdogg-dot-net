---
/**
 * The homepage. Design pass 2 (Ben, 2026-09-16): three surfaces — black on white dominating,
 * white on the brand green, white on orange — and "get rid of the 'your account card' in the
 * hero. too busy." Each band has one job, and no two coloured bands touch:
 *
 *   hero (white) -> proof (forest, slim) -> plans + add-ons (white) -> how it works (orange,
 *   white cards) -> real yards + guarantee (white) -> Josue (forest) -> reviews (white) ->
 *   where we work (forest) -> FAQ (white) -> close (orange) -> footer (deep green)
 *
 * Every number comes from the rows (S19). Region copy is two counties, not one (Ben).
 * Evidence for the choices: research/R5-COMPETITORS.md and research/R6-DESIGN-MONEY-AND-AI-SEARCH.md.
 */
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import Section from '../components/site/Section.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import AddressForm from '../components/site/AddressForm.astro';
import ProofBar from '../components/site/ProofBar.astro';
import PackageCards from '../components/site/PackageCards.astro';
import Steps from '../components/site/Steps.astro';
import BeforeAfter from '../components/site/BeforeAfter.astro';
import GuaranteeStamp from '../components/site/GuaranteeStamp.astro';
import ReviewQuotes from '../components/site/ReviewQuotes.astro';
import Faq from '../components/site/Faq.astro';
import CloseCta from '../components/site/CloseCta.astro';
import Stars from '../components/site/Stars.astro';
import { SITE_URL } from '../lib/constants';
import {
  business, markets, regionSentence, serviceRegion, services, headlinePrice, reviewSummary, reviews,
  packagesForService, formatCents, trust, setting, headlineOffer,
} from '../lib/catalog';

import josue from '../assets/photos/4824.jpg';
import turfBefore from '../assets/photos/turf1-before.jpg';
import turfAfter from '../assets/photos/turf2-after.jpg';
import runBefore from '../assets/photos/grass-dog-run-before.jpg';
import runAfter from '../assets/photos/grass-dog-run-after.jpg';
import yardBefore from '../assets/photos/backyard-before.jpg';
import yardAfter from '../assets/photos/backyard-after.jpg';
import enclosureBefore from '../assets/photos/enclosure-before.jpg';
import enclosureAfter from '../assets/photos/enclosure-after.jpg';

const scoop = packagesForService('weekly-pooper-scooper-service');
const from = scoop.length ? Math.min(...scoop.map((p) => p.monthly_price_cents)) : null;
const startDays = setting<number>('schedule.new_customer_start_days', 3);
const region = regionSentence();
const offer = headlineOffer?.name;

const title = 'Weekly Dog Poop Cleanup in Ventura & Santa Barbara Counties | Scoop Dogg';
const description = `Weekly dog poop pickup across ${region}, on the same day every week${from ? ` — from ${formatCents(from)} a month` : ''}. See your price in a minute.${offer ? ` ${offer}.` : ''} No contract.`;

const featured = reviews.find((r) => r.featured) ?? reviews[0];
const cardReviews = reviews.filter((r) => r.featured && r.id !== featured?.id).slice(0, 3).map((r) => r.id);

// Add-ons sit under the plans, where the decision is being made (R6 §B: revenue per customer).
const addOns = services
  .filter((s) => s.slug !== 'weekly-pooper-scooper-service')
  .map((s) => ({ s, price: headlinePrice(s.slug) }));

const steps = [
  { t: 'See your price', d: 'Your address and how many dogs. The monthly price is on screen before we ask for anything else.' },
  { t: 'Pick your day', d: `We serve each city on set days, so your day is the same every week. Start in as little as ${startDays} days.` },
  { t: 'Run it from your account', d: 'Your next visit, your plan and your payments in one place. Skip, pause or cancel in a tap.' },
];

const faqs = [
  { q: 'How does monthly billing work?', a: `You pay for your first month when you book${offer ? ` (${offer.toLowerCase()})` : ''}, and your plan renews each month after that. Your account shows the next payment date, and you can skip, pause or cancel before it.` },
  { q: 'Is there a contract?', a: 'No. Cancel anytime from your account, no questions asked.' },
  { q: 'Do I need to be home?', a: 'No. Most customers are at work when we stop by. As long as we can get into the yard, we take care of everything and close the gate behind us.' },
  { q: 'How soon can you start?', a: `Usually within ${startDays} days. You pick your start day from the days we serve your city, and that becomes your day every week.` },
  { q: 'My yard has not been cleaned in a while. Is that a problem?', a: 'Not at all. Tell us when you book, and we can add a one-time deep clean before your weekly visits start.' },
  { q: 'Which areas do you serve?', a: `${region}. If your address is not on a route yet, leave it with us and we will let you know when it is.` },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${SITE_URL}/#business`,
    name: 'Scoop Dogg',
    description,
    telephone: '+18058698070',
    email: business.email,
    url: SITE_URL,
    image: `${SITE_URL}/brand/mark-512.png`,
    logo: `${SITE_URL}/brand/mark-512.png`,
    address: { '@type': 'PostalAddress', addressLocality: 'Ventura', addressRegion: 'CA', addressCountry: 'US' },
    areaServed: [
      { '@type': 'AdministrativeArea', name: 'Ventura County, CA' },
      { '@type': 'AdministrativeArea', name: 'Santa Barbara County, CA' },
      ...markets().flatMap((m) => m.areas.map((a) => ({ '@type': 'City', name: `${a.name}, CA` }))),
    ],
    ...(scoop.length ? {
      makesOffer: scoop.map((p) => ({
        '@type': 'Offer',
        name: p.name,
        priceSpecification: { '@type': 'UnitPriceSpecification', price: (p.monthly_price_cents / 100).toFixed(2), priceCurrency: 'USD', unitText: 'MON' },
      })),
    } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const check = 'M5 12l5 5 9-10';
---
<Site title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>

  <!-- 1. HERO — the first step of booking, and one real yard -->
  <section class="tone-white relative overflow-hidden bg-paper">
    <div class="container-site relative grid items-center gap-12 pb-14 pt-10 lg:grid-cols-12 lg:gap-10 lg:pb-20 lg:pt-14">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-6">Pooper scoopers · {serviceRegion}</p>
        <h1 class="text-hero text-forest-900">
          Your yard, scooped.<br /><span class="text-orange-600">Every week.</span>
        </h1>
        <p class="mt-7 max-w-xl text-lg text-ink-700 sm:text-xl sm:leading-9">
          We clean up after your dog on the same day every week — bagged and hauled away{from && <>, from <strong class="font-semibold text-forest-900">{formatCents(from)} a month</strong></>}.
          {offer && <> {offer}.</>} No contract.
        </p>
        <div class="mt-9"><AddressForm heroAnchor source="home-hero" /></div>
        <ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink-700 sm:text-base">
          {reviewSummary.rating && (
            <li><a href="/reviews" class="inline-flex items-center gap-2 hover:text-forest-800">
              <Stars rating={reviewSummary.rating} size={16} />
              <span><strong class="font-semibold text-forest-900">{reviewSummary.rating.toFixed(1)}</strong> · {reviewSummary.count} Google reviews</span>
            </a></li>
          )}
          <li class="inline-flex items-center gap-1.5"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" class="text-forest-500" aria-hidden="true"><path d={check} /></svg>Start within {startDays} days</li>
        </ul>
      </div>

      <div class="relative hidden sm:block lg:col-span-5">
        <div class="relative mx-auto w-full max-w-[26rem] lg:mr-0">
          <div class="absolute -bottom-5 -right-5 left-10 top-10 rounded-xl bg-forest-700" aria-hidden="true"></div>
          <div class="relative">
            <BeforeAfter feature before={turfBefore} after={turfAfter} caption="A Scoop Dogg turf yard" alt="an artificial turf yard cleaned by Scoop Dogg" sizes="(min-width: 1024px) 416px, 90vw" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PROOF — operational, not adjectives (R5 §4) -->
  <ProofBar />

  <!-- 3. PLANS, with the add-ons where the decision is made -->
  <Section tone="white" labelledby="plans-title">
    <SectionHeading id="plans-title" eyebrow="Monthly plans" title="One price a month. Every visit covers the whole yard." lede={`Weekly scooping, priced by how many dogs you have.${offer ? ` ${offer}.` : ''}`}>
      <a slot="action" href="/pricing" class="link text-base">See all pricing</a>
    </SectionHeading>
    <div class="mt-12 lg:mt-14"><PackageCards service="weekly-pooper-scooper-service" /></div>
    <div class="mt-12 border-t border-line pt-8">
      <p class="text-sm font-semibold uppercase tracking-[0.12em] text-ink-500">Add to any plan, or book once</p>
      <ul class="mt-4 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-2.5">
        {addOns.map(({ s, price }) => (
          <li><a href={`/services/${s.slug}`} class="group flex h-full flex-col rounded-md border border-line-strong bg-paper px-3 py-2 text-forest-900 transition duration-fast hover:border-forest-500 hover:bg-forest-50 sm:flex-row sm:items-center sm:gap-2 sm:rounded-full sm:px-4">
            <span class="text-sm font-medium sm:text-base">{s.short_name || s.name}</span>
            {price && <span class="text-sm text-ink-500">{price.text.replace(/^From /, 'from ')}{price.per}</span>}
          </a></li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 4. HOW IT WORKS — orange; small text lives on the white cards -->
  <Section tone="orange" labelledby="how-title">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4">How it works</p>
        <h2 id="how-title" class="text-h1 text-white">Booked in a minute.<br />Handled every week.</h2>
      </div>
      <p class="text-statement text-white lg:col-span-5">No quotes to wait for and no phone tag. You never need to be home.</p>
    </div>
    <div class="mt-12"><Steps steps={steps} /></div>
    <div class="mt-10 grid gap-3 sm:flex sm:flex-wrap sm:items-center sm:gap-4">
      <a href="/book" class="btn-forest btn-lg" data-cta="how">See my price</a>
      <a href="/how-it-works" class="btn-white btn-lg">What happens on a visit</a>
    </div>
  </Section>

  <!-- 5. REAL YARDS + the guarantee -->
  <Section tone="white" labelledby="proof-title">
    <SectionHeading id="proof-title" eyebrow="Real yards" title="Actually clean. Every corner." lede="Scoop Dogg jobs, before and after. Drag across a photo to compare.">
      <a slot="action" href="/gallery" class="link text-base">More before-and-afters</a>
    </SectionHeading>
    <div class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-6 sm:overflow-visible sm:px-0 [&>figure]:w-[72%] [&>figure]:shrink-0 [&>figure]:snap-center sm:[&>figure]:w-auto">
      <BeforeAfter before={runBefore} after={runAfter} caption="Side-yard dog run" alt="side-yard dog run" />
      <BeforeAfter before={yardBefore} after={yardAfter} caption="Backyard" alt="backyard" />
      <BeforeAfter before={enclosureBefore} after={enclosureAfter} caption="Dog enclosure" alt="dog enclosure" />
    </div>
    {trust.guarantee && (
      <div class="tone-tint mt-14 flex flex-col gap-6 rounded-xl bg-tone-bg p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between">
        <GuaranteeStamp size={112} />
        <a href="/book" class="btn-primary btn-lg shrink-0" data-cta="guarantee">See my price</a>
      </div>
    )}
  </Section>

  <!-- 6. JOSUE — the owner, large, on the brand green -->
  <Section tone="forest" labelledby="josue-title">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-sm lg:max-w-none">
          <Image src={josue} alt="Josue, owner of Scoop Dogg, cleaning a backyard" widths={[400, 800]} sizes="(min-width: 1024px) 440px, 85vw" class="aspect-[4/5] w-full rounded-xl object-cover shadow-lg" />
          <img src="/brand/mark-192.png" alt="" width="96" height="96" class="absolute -bottom-6 -right-4 h-24 w-24 rounded-full border-4 border-forest-700 shadow-md" loading="lazy" />
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="eyebrow mb-5">Meet the owner</p>
        <h2 id="josue-title" class="text-h1 text-white">“I know my clients' dogs by name.”</h2>
        <div class="mt-7 space-y-4 text-lg text-tone-fg">
          <p>I'm Josue. I started Scoop Dogg because dog owners shouldn't have to dread their own backyard.</p>
          <p>I know which gates stick and which yards have the sneaky spots. This isn't a side hustle — it's my business, and I take it personally.</p>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-7 gap-y-3 text-base font-medium text-white">
          {trust.insured && <li class="inline-flex items-center gap-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" class="text-amber-400" aria-hidden="true"><path d={check} /></svg>Fully insured</li>}
          {trust.backgroundChecked && <li class="inline-flex items-center gap-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" class="text-amber-400" aria-hidden="true"><path d={check} /></svg>Background-checked</li>}
          <li class="inline-flex items-center gap-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" class="text-amber-400" aria-hidden="true"><path d={check} /></svg>Locally owned</li>
        </ul>
        <a href="/about" class="btn-ghost mt-9">More about Josue</a>
      </div>
    </div>
  </Section>

  <!-- 7. REVIEWS — the words, the count, and the date (R6 §A5) -->
  {featured && (
    <Section tone="white" labelledby="reviews-title">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-4">
          <p class="eyebrow mb-4">Reviews</p>
          <h2 id="reviews-title" class="text-h2 text-forest-900">Dog owners say it best</h2>
          {reviewSummary.rating && (
            <div class="mt-6 flex items-center gap-4">
              <span class="font-serif text-hero leading-none text-forest-900">{reviewSummary.rating.toFixed(1)}</span>
              <span class="flex flex-col gap-1"><Stars rating={reviewSummary.rating} size={20} /><span class="text-base text-ink-500">{reviewSummary.count} Google reviews</span></span>
            </div>
          )}
        </div>
        <figure class="lg:col-span-8">
          <blockquote class="font-serif text-h3 text-forest-900">“{featured.quote}”</blockquote>
          <figcaption class="mt-6 text-base text-ink-500"><span class="font-semibold text-forest-900">{featured.author_name}</span> · Google review{featured.reviewed_on ? ` · ${featured.reviewed_on}` : ''}</figcaption>
        </figure>
      </div>
      <div class="mt-14"><ReviewQuotes ids={cardReviews} limit={3} /></div>
    </Section>
  )}

  <!-- 8. WHERE WE WORK — green, the city list is the local proof -->
  <Section tone="forest" labelledby="areas-title">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow mb-4">Where we work</p>
        <h2 id="areas-title" class="text-h2 text-white">Local routes across two counties</h2>
        <p class="mt-5 text-lg text-tone-fg">Each city has set service days. That is how every customer gets the same day every week.</p>
        <a href="/areas" class="btn-primary mt-8">Check my address</a>
      </div>
      <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:col-span-7 lg:col-start-6 lg:pl-8">
        {markets().map((m) => (
          <div>
            <h3 class="border-b border-white/15 pb-3 font-sans text-base font-semibold uppercase tracking-[0.1em] text-amber-400">{m.label.replace(/^the /, 'The ')}</h3>
            <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2">
              {m.areas.map((a) => <li><a href={`/areas/${a.slug}`} class="inline-block py-1 text-base text-white underline decoration-white/0 underline-offset-4 transition duration-fast hover:decoration-amber-400">{a.name}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- 9. FAQ -->
  <Section tone="white" labelledby="faq-title">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow mb-4">Questions</p>
        <h2 id="faq-title" class="text-h2 text-forest-900">Questions, answered</h2>
        <p class="mt-5 text-lg text-ink-700">Something else? Call or text <a href={business.phoneHref} class="link whitespace-nowrap">{business.phone}</a>.</p>
      </div>
      <div class="lg:col-span-8"><Faq items={faqs} /></div>
    </div>
  </Section>

  <!-- 10. CLOSE -->
  <CloseCta source="home-close" />
</Site>
