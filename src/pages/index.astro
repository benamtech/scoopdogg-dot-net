---
/**
 * The homepage — Josue's page, with the demo's machine inside it.
 *
 * P15 is the port. Ben, 2026-09-18: *"he loves his current website so he wants to keep his
 * website basically the way it is, like the main design, but still implement all those funnel
 * changes"*, and, asked how literal: *"section-for-section port ... the best parts of each but
 * without restriction for adding."*
 *
 * THE ORDER IS THE LIVE PAGE'S ORDER, verified against `origin/main:src/pages/index.astro`:
 * Hero → Services → How It Works → Meet Josue → Reviews → Real Results → Areas → FAQ → Book.
 * Design pass 2 had reordered it and dropped the video, the cartoons and the service groups;
 * they come back, and the four bands the demo added (proof strip, plan grid, guides, and the
 * funnel inside the hero) stay.
 *
 * THE SURFACES ARE THE LIVE PAGE'S (2026-10-02). Josue asked for the new build to look
 * "basically like the current site", and what he means by that is measurable on scoopdogg.net:
 * the bright amber band, the service groups alternating sage and white, the forest review band,
 * centred headings with a small pill above them, round buttons, and the cartoons large, rising
 * out of the corner of each card. The deeper orange and the left-aligned editorial headings the
 * elevation pass introduced are gone from this page. The funnel he likes stays exactly where it
 * was: the ZIP field in the hero, the plan ladder, and the ZIP field again at the close.
 *
 *   photo(hero) → forest(proof) → amber(services intro) → sage(yard) → white(turf) →
 *   sage(landscaping) → forest(pressure washing) → white(indoor) → sage(summary) →
 *   white(plans) → sage(how) → white(Josue) → forest(reviews) → cream(real yards) →
 *   amber(areas) → white(guides) → cream(FAQ) → forest(book) → deep(footer)
 *
 * No two adjacent bands share a tone and the page is well under 60% white by rendered height
 * (`gates/surface-rhythm.mjs`).
 *
 * Every number comes from a row. Every price on this page resolves through `headlinePrice()`
 * or `PackageCards`, and `gates/no-price-in-prose.mjs` is what stops one being typed back in.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Site from '../layouts/Site.astro';
import Section from '../components/site/Section.astro';
import HeroVideo from '../components/site/HeroVideo.astro';
import ProofBar from '../components/site/ProofBar.astro';
import ServiceGroup from '../components/site/ServiceGroup.astro';
import ServiceCard from '../components/site/ServiceCard.astro';
import MediaBand from '../components/site/MediaBand.astro';
import KnowledgeBand from '../components/site/KnowledgeBand.astro';
import PackageCards from '../components/site/PackageCards.astro';
import BeforeAfter from '../components/site/BeforeAfter.astro';
import GuaranteeStamp from '../components/site/GuaranteeStamp.astro';
import ReviewQuotes from '../components/site/ReviewQuotes.astro';
import Faq from '../components/site/Faq.astro';
import CloseCta from '../components/site/CloseCta.astro';
import { RefreshCw, Sparkles, Cat, Wind, Scissors, Brush, Fence, Droplets, Bot, Hammer } from 'lucide-react';
import Stars from '../components/site/Stars.astro';
import { SITE_URL } from '../lib/constants';
import {
  business, markets, regionSentence, serviceRegion, services, headlinePrice, reviewSummary, reviews,
  packagesForService, formatCents, trust, setting, headlineOffer,
} from '../lib/catalog';
import { ARTICLES } from '../lib/articles';
import { questions } from '../lib/questions';

import heroPoster from '../assets/video/hero-poster.jpg';
import josue from '../assets/photos/4824.jpg';
import runBefore from '../assets/photos/grass-dog-run-before.jpg';
import runAfter from '../assets/photos/grass-dog-run-after.jpg';
import yardBefore from '../assets/photos/backyard-before.jpg';
import yardAfter from '../assets/photos/backyard-after.jpg';
import enclosureBefore from '../assets/photos/enclosure-before.jpg';
import enclosureAfter from '../assets/photos/enclosure-after.jpg';

// THE SEVEN CARTOONS. P15 §3 counted seven on the live homepage and nine in the repository;
// these are them, and every one goes through `astro:assets` so it ships resized as WebP rather
// than as the full PNG the live site serves.
import artShovel from '../assets/art/dogs-with-shovel.png';
import artShovelOne from '../assets/art/dog-with-shovel.png';
import artJumping from '../assets/art/dog-jumping.png';
import artDeodorizer from '../assets/art/dog-spraying-turf-deodorizer.png';
import artMower from '../assets/art/dog-with-lawn-mower.png';
import artWeedwacker from '../assets/art/dog-with-weedwacker.png';
import artMowing from '../assets/art/transp-dog-character-mowing-grass.png';
import artPressure from '../assets/art/transp-dog-character-pressure-washing-driveway.png';
import artLitter from '../assets/art/transp-cat-character-cleaning-litter-box.png';
import artLitterRobot from '../assets/art/5878.jpg';
import artPressureScene from '../assets/art/img-20260523-162331.jpg';
import artCatTree from '../assets/art/transp-cat-character-cleaning-cat-tree.png';

const scoop = packagesForService('weekly-pooper-scooper-service');
const from = scoop.length ? Math.min(...scoop.map((p) => p.monthly_price_cents)) : null;
const perVisit = from ? Math.round(from / (52 / 12) / 100) * 100 : null;
const startDays = setting<number>('schedule.new_customer_start_days', 3);
const region = regionSentence();
const offer = headlineOffer?.name;

const title = 'Dog Poop Cleaning Services in Ventura County, CA | Scoop Dogg';
const description = `Weekly dog poop pickup across ${serviceRegion}, on the same day every week${from ? ` — from ${formatCents(from)} a month` : ''}. See your price in a minute.${offer ? ` ${offer}.` : ''} No contract.`;

const featured = reviews.find((r) => r.featured) ?? reviews[0];
const cardReviews = reviews.filter((r) => r.featured && r.id !== featured?.id).slice(0, 3).map((r) => r.id);

/**
 * The five groups the live page divides its services into, in its order. A visitor with a cat
 * reads two headings and stops, which is what the grouping is for.
 *
 * The card copy is TAKEN FROM THE ROW, not typed here: `sub` from the service's own basis
 * label, `description` from the first sentences of its intro, `includes` from
 * `what_includes`, the price from `headlinePrice()`. So a service edited in the admin changes
 * its card, and the card cannot disagree with its own service page.
 */
const svc = (slug: string) => services.find((s) => s.slug === slug);
/** The first one or two sentences of an intro — a card's worth, without cutting mid-word. */
const blurb = (text: string | null | undefined, max = 190) => {
  const t = (text ?? '').trim();
  if (t.length <= max) return t;
  const cut = t.slice(0, max);
  const stop = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '));
  return stop > 80 ? cut.slice(0, stop + 1) : `${cut.slice(0, cut.lastIndexOf(' '))}…`;
};

type CardSpec = { slug: string; sub: string; cta: string; icon: typeof RefreshCw; art?: ImageMetadata; artAlt?: string; framed?: boolean; badge?: string | null; featured?: boolean };

/**
 * The live page's groups, with its labels and its titles. Each is a band of its own colour.
 * Pressure washing is not in this list: on scoopdogg.net it is a featured band on the brand
 * green with the illustrated scene beside it, and it is drawn that way below.
 */
const GROUPS: { label: string; title: string; lede: string; tone: 'sage' | 'white'; cols: 2 | 3; cards: CardSpec[]; custom?: boolean }[] = [
  {
    label: 'Yard cleaning',
    title: 'Weekly Pet Waste Removal',
    lede: `The foundation of everything we do. Consistent weekly visits keep your yard clean, so you never have to think about dog poop again. Billed monthly${offer ? ` — ${offer.toLowerCase()}` : ''}.`,
    tone: 'sage', cols: 3,
    cards: [
      { slug: 'weekly-pooper-scooper-service', sub: 'Weekly scooping — billed monthly', cta: 'Get weekly service', icon: RefreshCw, art: artShovel, artAlt: 'Two Scoop Dogg dogs holding scooping tools', badge: 'Most popular', featured: true },
      { slug: 'one-time-dog-poop-cleanup', sub: 'One-time catch-up clean', cta: 'Book a one-time clean', icon: Sparkles, art: artShovelOne, artAlt: 'A Scoop Dogg dog with a shovel' },
      { slug: 'dog-run-cleanups', sub: 'Runs, kennels and side yards', cta: 'Book a run cleanup', icon: Fence, art: artJumping, artAlt: 'Two Scoop Dogg dogs jumping in a clean yard' },
    ],
  },
  {
    label: 'Turf maintenance',
    title: 'Artificial Turf, Kept Like New',
    lede: 'Most people install artificial turf thinking it is zero maintenance. It is not — especially with dogs. We bring the SwipeSmith turf sweeper, pressure washing equipment and professional-grade enzyme treatments.',
    tone: 'white', cols: 3,
    cards: [
      { slug: 'yard-deep-clean', sub: 'One-time deep clean & restoration', cta: 'Book a deep clean', icon: Sparkles, art: artMower, artAlt: 'A Scoop Dogg dog with a lawn mower' },
      { slug: 'artificial-turf-deodorizing', sub: 'Enzyme treatment for odor', cta: 'Book deodorizing', icon: Droplets, art: artDeodorizer, artAlt: 'A Scoop Dogg dog spraying turf deodorizer' },
      { slug: 'weekly-turf-maintenance', sub: 'Ongoing sweeping & deodorizing', cta: 'Get turf maintenance', icon: Brush, badge: 'New', art: artWeedwacker, artAlt: 'A Scoop Dogg dog with a weedwacker' },
    ],
  },
  {
    label: 'Landscaping',
    title: 'Yard Restoration & Ongoing Maintenance',
    lede: 'Some yards need a serious reset before weekly upkeep makes sense. We handle the heavy lifting — overgrowth, debris, dead brush — then move into regular maintenance that keeps things looking clean.',
    tone: 'sage', cols: 2, custom: true,
    cards: [
      { slug: 'weekly-yard-maintenance', sub: 'Mowing, trimming & general upkeep', cta: 'See yard pricing', icon: Scissors, badge: 'New', art: artMowing, artAlt: 'A Scoop Dogg dog mowing grass' },
    ],
  },
  {
    label: 'Extra pet services',
    title: 'Indoor Pet Cleanup',
    lede: 'Not just yards. We also handle the indoor jobs nobody wants — litter boxes and cat trees. Same team, same reliable schedule.',
    tone: 'white', cols: 3,
    cards: [
      { slug: 'kitty-litter-exchange', sub: 'Weekly litter box cleaning', cta: 'Add litter exchange', icon: Cat, art: artLitter, artAlt: 'A Scoop Dogg cat cleaning a litter box' },
      { slug: 'cat-tree-cleaning', sub: 'Pet furniture deep clean', cta: 'Book cat tree cleaning', icon: Wind, art: artCatTree, artAlt: 'A Scoop Dogg cat cleaning a cat tree' },
      { slug: 'kitty-litter-robot-cleaning', sub: 'Automatic litter box care', cta: 'Book a Litter-Robot clean', icon: Bot, art: artLitterRobot, artAlt: 'A Litter-Robot automatic litter box being cleaned', framed: true },
    ],
  },
];
const pressure = svc('pressure-washing');
const pressurePrice = pressure ? headlinePrice(pressure.slug) : null;
const cityCount = markets().reduce((n, m) => n + m.areas.length, 0);

const steps = [
  { t: 'Pick your service', d: 'Your ZIP and how many dogs. The monthly price is on screen before we ask for anything else.' },
  { t: 'We show up', d: `We serve each city on set days, so your day is the same every week. Start in as little as ${startDays} days. You never need to be home.` },
  { t: 'Enjoy your yard', d: 'Your next visit, your plan and your payments in one place. Skip, pause or cancel in a tap.' },
];

const faqs = [
  { q: 'How does monthly billing work?', a: `You pay for your first month when you book${offer ? ` (${offer.toLowerCase()})` : ''}, and your plan renews each month after that. Your account shows the next payment date, and you can skip, pause or cancel before it.` },
  { q: 'Is there a contract?', a: 'No. Cancel anytime from your account, no questions asked.' },
  { q: 'Do I need to be home?', a: 'No. Most customers are at work when we stop by. As long as we can get into the yard, we take care of everything and close the gate behind us.' },
  { q: 'How soon can you start?', a: `Usually within ${startDays} days. You pick your start day from the days we serve your city, and that becomes your day every week.` },
  { q: 'My yard has not been cleaned in a while. Is that a problem?', a: 'Not at all. Tell us when you book, and we can add a one-time deep clean before your weekly visits start.' },
  { q: 'Which areas do you serve?', a: `${region}. If your address is not on a route yet, leave it with us and we will let you know when it is.` },
];

// The orphans, given their first inbound links from the homepage (P15 §8).
const guides = ARTICLES.map((a) => ({ slug: a.slug, title: a.title, summary: a.excerpt }));
const questionLinks = questions().map((q) => ({ slug: q.slug, question: q.q }));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${SITE_URL}/#business`,
    name: 'Scoop Dogg',
    description,
    telephone: '+18058698070',
    email: business.email,
    url: SITE_URL,
    image: `${SITE_URL}/brand/mark-512.png`,
    logo: `${SITE_URL}/brand/mark-512.png`,
    address: { '@type': 'PostalAddress', addressLocality: 'Ventura', addressRegion: 'CA', addressCountry: 'US' },
    /**
     * sameAs — THE ONE LINE THAT CONNECTS THIS PAGE TO THE THING AI SEARCH ACTUALLY CITES.
     *
     * Chen, Wang, Chen & Koudas (arXiv:2509.08919) measured the citation mix of AI answers against
     * Google's: GPT cited EARNED media 72-92% of the time across three sectors and brand-owned
     * 18-27%, where Google sits near 33-44% brand-owned. Their guidance for a niche player is to
     * make the brand-owned surface machine-parseable and to be identifiable with the third-party
     * entity that does get cited. For a local service that entity is the Google Business Profile.
     *
     * `sameAs` is the assertion that this page and that profile are one business. It costs one
     * line. (Caveat kept honest: their sectors were automotive, consumer electronics and software,
     * not local services — the direction was consistent across every engine, the magnitude here is
     * nobody's measurement. R11 §C1.)
     *
     * It reads the SETTINGS ROW, not a literal, so it cannot drift from the link /reviews shows.
     * `geo` is deliberately absent: the coordinate lives in `routing.%`, which is server-only on
     * purpose, and Google already has it from the profile this now points at.
     */
    sameAs: [reviewSummary.profileUrl],
    areaServed: [
      { '@type': 'AdministrativeArea', name: 'Ventura County, CA' },
      { '@type': 'AdministrativeArea', name: 'Santa Barbara County, CA' },
      ...markets().flatMap((m) => m.areas.map((a) => ({ '@type': 'City', name: `${a.name}, CA` }))),
    ],
    ...(scoop.length ? {
      makesOffer: scoop.map((p) => ({
        '@type': 'Offer',
        name: p.name,
        priceSpecification: { '@type': 'UnitPriceSpecification', price: (p.monthly_price_cents / 100).toFixed(2), priceCurrency: 'USD', unitText: 'MON' },
      })),
    } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

/**
 * THE PRELOAD HAS TO NAME THE SAME FILES THE <Image> WILL ASK FOR.
 *
 * A `<link rel=preload as=image href="...">` pointing at a different URL than the rendered
 * srcset does not warm the cache — it downloads a second image and makes LCP worse, which is
 * the trap in preloading a responsive image at all. `getImage()` generates the identical
 * srcset, so `imagesrcset` + `imagesizes` here and `widths` + `sizes` in HeroVideo resolve to
 * the same candidate on every viewport.
 */
const posterPreload = await getImage({
  src: heroPoster, widths: [390, 640, 960, 1280], sizes: '100vw', format: 'webp', quality: 62,
});

---
<Site title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  {/*
    THE LCP PRELOAD. The hero poster is the largest thing above the fold and therefore the
    Largest Contentful Paint element; preloading it at high priority is the single highest-value
    line on this page. It sits here rather than in HeroVideo.astro because Astro's head slot
    only reaches the layout from the page (see the note in that component).
  */}
  <link
    slot="head"
    rel="preload"
    as="image"
    href={posterPreload.src}
    imagesrcset={posterPreload.srcSet.attribute}
    imagesizes="100vw"
    fetchpriority="high"
  />

  {/* 1. HERO — the video, the serif headline, and the funnel's first question */}
  <HeroVideo
    fromCents={from}
    perVisitCents={perVisit}
    serviceRegion={serviceRegion}
    phone={business.phone}
    phoneHref={business.phoneHref}
    rating={reviewSummary.rating}
    reviewCount={reviewSummary.googleCount}
    quoteCount={reviewSummary.quotes}
    offer={offer ?? null}
  />

  {/* 2. PROOF — operational, not adjectives (R5 §4) */}
  <ProofBar />

  {/* 3. OUR SERVICES — the live page's amber intro: centred serif heading in dark green, and
       Josue's own before/after animation with its caption beside it. */}
  <Section tone="amber" labelledby="services-title">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="services-title" class="text-h2 text-tone-heading">Our Services</h2>
      <p class="mt-5 text-lg text-tone-fg">From a messy first visit to a clean-every-week routine — here is how we get your yard, turf and patio looking right and keep it that way. Every price here is the price you book at.</p>
    </div>
    <div class="mx-auto mt-10 flex max-w-3xl flex-col items-center gap-6 md:flex-row md:items-center md:gap-10">
      <div class="w-full max-w-xs shrink-0 md:w-80 md:max-w-none">
        <MediaBand
          src="/video/before-after.mp4"
          posterImage={yardAfter}
          label="before-and-after animation"
          width={480}
          height={560}
          class="shadow-lg"
        />
      </div>
      <div class="text-center md:text-left">
        <p class="font-serif text-h3 text-tone-heading">The results speak for themselves.</p>
        <p class="mt-3 text-lg text-tone-fg">Animation created using real before and after photos.</p>
        <a href="/gallery" class="btn-forest mt-6">See more before and afters</a>
      </div>
    </div>
  </Section>

  {GROUPS.slice(0, 3).map((g) => (
    <ServiceGroup label={g.label} title={g.title} lede={g.lede} tone={g.tone} cols={g.cols}>
      {g.cards.map((card) => {
        const s = svc(card.slug);
        const Icon = card.icon;
        return s ? (
          <ServiceCard
            slug={s.slug}
            name={s.name}
            sub={card.sub}
            description={blurb(s.intro)}
            includes={s.what_includes ?? []}
            price={headlinePrice(s.slug)}
            priceNote={s.slug === 'weekly-pooper-scooper-service' && offer ? offer : null}
            cta={card.cta}
            art={card.art}
            artAlt={card.artAlt}
            framed={card.framed}
            badge={card.badge}
            featured={card.featured}
          ><Icon slot="icon" size={20} strokeWidth={2.5} /></ServiceCard>
        ) : null;
      })}
      {g.custom && (
        // The big-job lane (R21). The price list stops at a few hundred dollars and Josue's
        // largest days are custom yard and property work, so it gets a card where the visitor
        // who needs it is already reading.
        <ServiceCard
          slug="custom-quote"
          name="Custom Yard & Property Jobs"
          sub="Quoted by Josue"
          description="Overgrowth resets, haul-away, turf and landscaping work, and large clean-ups that do not fit a price list. Send a few photos and get an itemised quote."
          includes={['A few photos is usually enough', 'Every line itemised', 'A deposit books it; the balance after the work', 'Approve it online when you are ready']}
          includesLabel="How it works:"
          price={null}
          cta="Get a custom quote"
          href="/custom-quote"
          learnHref={null}
          art={artPressure}
          artAlt="A Scoop Dogg dog pressure washing a driveway"
        ><Hammer slot="icon" size={20} strokeWidth={2.5} /></ServiceCard>
      )}
    </ServiceGroup>
  ))}

  {/* PRESSURE WASHING — the live page's featured band: brand green, the illustrated scene, an
       amber button. The scene is a bordered picture, so it is framed, never floated. */}
  {pressure && (
    <Section tone="forest" labelledby="pressure-title">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="text-micro font-bold uppercase text-forest-300">Featured service</p>
          <h3 id="pressure-title" class="mt-3 font-serif text-h2 text-white">{pressure.name}</h3>
          <p class="mt-5 text-lg text-tone-fg">{blurb(pressure.intro, 260)}</p>
          <ul class="mt-6 space-y-2.5">
            {(pressure.what_includes ?? []).slice(0, 4).map((d) => (
              <li class="flex items-start gap-3 text-base text-tone-fg"><span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-amber-500" aria-hidden="true"></span>{d}</li>
            ))}
          </ul>
          {pressurePrice && <p class="mt-8 text-xl font-bold text-white" data-price-cents={pressurePrice.cents}>{pressurePrice.text}{pressurePrice.per}</p>}
          <p class="mt-1 text-sm text-tone-muted">Driveways, patios, dog runs and more</p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a href={`/book?service=${pressure.slug}`} class="btn-primary btn-lg" data-cta={`service-${pressure.slug}`}>Book pressure washing
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href={`/services/${pressure.slug}`} class="text-base font-medium text-white underline decoration-white/40 underline-offset-4 hover:decoration-amber-400">Learn more<span class="sr-only"> about {pressure.name}</span></a>
          </div>
        </div>
        <div class="relative mx-auto w-fit max-w-md lg:max-w-none">
          <Image src={artPressureScene} alt="Scoop Dogg mascot pressure washing a driveway" widths={[400, 640, 960]} sizes="(min-width: 1024px) 540px, 90vw" class="mx-auto h-auto max-h-[480px] w-auto max-w-full rounded-xl shadow-lg" loading="lazy" />
          <span class="absolute -right-2 -top-3 rounded-full bg-amber-500 px-4 py-2 text-sm font-bold text-forest-900 shadow-lg">Most requested add-on</span>
        </div>
      </div>
    </Section>
  )}

  {GROUPS.slice(3).map((g) => (
    <ServiceGroup label={g.label} title={g.title} lede={g.lede} tone={g.tone} cols={g.cols}>
      {g.cards.map((card) => {
        const s = svc(card.slug);
        const Icon = card.icon;
        return s ? (
          <ServiceCard
            slug={s.slug}
            name={s.name}
            sub={card.sub}
            description={blurb(s.intro, 150)}
            includes={(s.what_includes ?? []).slice(0, 3)}
            price={headlinePrice(s.slug)}
            cta={card.cta}
            art={card.art}
            artAlt={card.artAlt}
            framed={card.framed}
            badge={card.badge}
          ><Icon slot="icon" size={20} strokeWidth={2.5} /></ServiceCard>
        ) : null;
      })}
    </ServiceGroup>
  ))}

  {/* The live page's closing line under the services, word for word. */}
  <Section tone="sage" size="sm">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-lg text-tone-fg">Poop scooping. Turf sweeping. Landscaping. Pressure washing. Litter boxes. We are the one reliable service that keeps your entire property — inside and out — clean every single week.</p>
      <a href="/services" class="mt-4 inline-flex items-center gap-2 text-base font-semibold text-forest-700 hover:text-forest-900">View all service details
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </Section>

  {/* 4. PLANS — new to the live page: the ladder, with the badge on the row the leads support */}
  <Section tone="white" labelledby="plans-title">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow-chip mb-5">Monthly plans</p>
      <h2 id="plans-title" class="text-h2 text-tone-heading">One Price a Month. The Whole Yard, Every Visit.</h2>
      <p class="mt-4 text-lg text-tone-muted">Weekly scooping, priced by how many dogs you have.{offer ? ` ${offer}.` : ''}</p>
    </div>
    <div class="mt-12 lg:mt-14"><PackageCards service="weekly-pooper-scooper-service" /></div>
    <p class="mt-8 text-center"><a href="/pricing" class="link text-base">See all pricing</a></p>
  </Section>

  {/* 5. HERE'S HOW IT WORKS — the live page's three numbered circles on a rule */}
  <Section tone="sage" labelledby="how-title">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="how-title" class="text-h2 text-tone-heading">Here's How It Works</h2>
      <p class="mt-4 text-lg text-tone-muted">Getting started takes about a minute. No quotes to wait for and no phone tag.</p>
    </div>
    <ol class="relative mt-14 grid gap-12 md:grid-cols-3 md:gap-8">
      <span class="absolute left-[16.6%] right-[16.6%] top-6 hidden h-px bg-forest-300 md:block" aria-hidden="true"></span>
      {steps.map((st, i) => (
        <li class="relative flex flex-col items-center text-center">
          <span class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-forest-700 bg-paper text-lg font-bold text-forest-800 shadow-sm" aria-hidden="true">{i + 1}</span>
          <h3 class="mt-6 font-serif text-h3 text-forest-900">{st.t}</h3>
          <p class="mt-3 max-w-xs text-base text-ink-700">{st.d}</p>
        </li>
      ))}
    </ol>
    <div class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
      <a href="/book" class="btn-primary btn-lg" data-cta="how">See my price</a>
      <a href="/how-it-works" class="btn-white btn-lg">What happens on a visit</a>
    </div>
  </Section>

  {/* 6. MEET JOSUE — the live band: his photograph, the rating badge on its corner, his words */}
  <Section tone="white" labelledby="josue-title">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-sm lg:max-w-none">
          <Image src={josue} alt="Josue, owner of Scoop Dogg, cleaning a backyard" widths={[400, 800]} sizes="(min-width: 1024px) 440px, 85vw" class="aspect-[4/5] w-full rounded-card object-cover shadow-lg" />
          {reviewSummary.rating && (
            <a href="/reviews" class="absolute -bottom-5 -right-3 rounded-lg bg-forest-700 px-5 py-4 text-white shadow-lg sm:-right-5">
              <span class="block font-serif text-h3 leading-none">{reviewSummary.rating.toFixed(1)}</span>
              <span class="mt-1.5 block"><Stars rating={reviewSummary.rating} size={13} /></span>
              <span class="mt-1 block text-sm text-forest-200">on Google</span>
            </a>
          )}
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="eyebrow-chip mb-5">Meet the owner</p>
        <h2 id="josue-title" class="text-h2 text-tone-heading">Meet Josue</h2>
        <blockquote class="mt-6 border-l-4 border-amber-500 pl-5 font-serif text-xl italic text-forest-900">“I'm out scooping alongside my team every week.”</blockquote>
        <div class="mt-6 space-y-4 text-lg text-tone-fg">
          <p>I'm Josue. I started Scoop Dogg because I got tired of seeing dog owners stressed about something that should be simple. You love your dog. You shouldn't have to dread your own backyard.</p>
          <p>I know my clients' dogs by name, I know which gates stick, and I know which yards have the sneaky spots. This isn't a side hustle — it's my business, and I take it personally.</p>
        </div>
        <p class="mt-6 text-lg font-bold text-ink-900">Every visit, every yard, done right.</p>
        <ul class="mt-7 flex flex-wrap gap-2.5 text-sm font-semibold text-forest-800">
          {trust.insured && <li class="rounded-full border border-line-strong bg-cream px-4 py-2">Fully insured</li>}
          {trust.backgroundChecked && <li class="rounded-full border border-line-strong bg-cream px-4 py-2">Background-checked</li>}
          <li class="rounded-full border border-line-strong bg-cream px-4 py-2">Locally owned</li>
          <li class="rounded-full border border-line-strong bg-cream px-4 py-2">Cancel anytime</li>
        </ul>
        <a href="/about" class="btn-ghost mt-8">More about Josue</a>
      </div>
    </div>
  </Section>

  {/* 7. WHAT OUR CUSTOMERS SAY — the live band: brand green, centred, one line of a real
       review in amber. ONE count from ONE row, and the date (R6 §A5). */}
  {featured && (
    <Section tone="forest" labelledby="reviews-title">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow-chip mb-5">Customer reviews</p>
        <h2 id="reviews-title" class="text-h2 text-white">What Our Customers Say</h2>
        <figure class="mt-6">
          <blockquote class="font-serif text-h3 italic text-amber-400">“{blurb(featured.quote, 150)}”</blockquote>
          <figcaption class="mt-4 text-base text-tone-muted"><span class="font-semibold text-white">{featured.author_name}</span> · Google review{featured.reviewed_on ? ` · ${featured.reviewed_on}` : ''}</figcaption>
        </figure>
        {reviewSummary.rating && (
          <div class="mt-5 flex items-center justify-center gap-3">
            <Stars rating={reviewSummary.rating} size={18} />
            {/* P15 §7 defect 1: the live page said "19 Google reviews" in one place and
                "all 27 reviews" 300px lower while the database held 18. ONE number, from
                ONE row. */}
            <span class="text-base text-tone-fg">{reviewSummary.rating.toFixed(1)} · {reviewSummary.label}</span>
          </div>
        )}
      </div>
      <div class="mt-12"><ReviewQuotes ids={cardReviews} limit={3} footer={false} /></div>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-5">
        <a href="/reviews" class="btn-ghost-dark">Read all {reviewSummary.shown} reviews</a>
        <a href={reviewSummary.profileUrl} rel="noopener" class="text-base font-medium text-white underline decoration-white/40 underline-offset-4 hover:decoration-amber-400">View on Google</a>
      </div>
    </Section>
  )}

  {/* 8. REAL RESULTS, REAL YARDS — the graded photographs, draggable, on cream */}
  <Section tone="cream" labelledby="results-title">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-micro font-bold uppercase text-tone-accent">Before &amp; after</p>
      <h2 id="results-title" class="mt-3 text-h2 text-tone-heading">Real Results, Real Yards</h2>
      <p class="mt-4 text-lg text-tone-muted">We let the work speak for itself. Drag across a photo to compare.</p>
    </div>
    <div class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-6 sm:overflow-visible sm:px-0 [&>figure]:w-[72%] [&>figure]:shrink-0 [&>figure]:snap-center sm:[&>figure]:w-auto">
      <BeforeAfter before={runBefore} after={runAfter} caption="Side-yard dog run" alt="side-yard dog run" />
      <BeforeAfter before={yardBefore} after={yardAfter} caption="Backyard" alt="backyard" />
      <BeforeAfter before={enclosureBefore} after={enclosureAfter} caption="Dog enclosure" alt="dog enclosure" />
    </div>
    <p class="mt-10 text-center"><a href="/gallery" class="btn-forest">View full gallery
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a></p>
    {trust.guarantee && (
      <div class="mt-12 flex flex-col gap-6 rounded-card border border-tone-rule bg-paper p-6 shadow-card sm:p-8 lg:flex-row lg:items-center lg:justify-between">
        <GuaranteeStamp size={112} />
        <a href="/book" class="btn-primary btn-lg shrink-0" data-cta="guarantee">See my price</a>
      </div>
    )}
  </Section>

  {/* 9. SERVING ALL OF VENTURA COUNTY AND MORE — the live band: amber, centred, every city a
       white tile. The count comes from markets() (P15 §7 defect 2). */}
  <Section tone="amber" labelledby="areas-title">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow-chip mb-5">Service area</p>
      <h2 id="areas-title" class="text-h2 text-tone-heading">Serving All of Ventura County and More</h2>
      <p class="mt-4 text-lg text-tone-fg">We cover {cityCount} cities. Each has set service days, so your day is the same every week.</p>
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-4">
      {markets().flatMap((m) => m.areas).map((a) => (
        <li><a href={`/areas/${a.slug}`} class="flex items-center justify-center rounded-md bg-paper px-3 py-3.5 text-center text-base font-semibold text-forest-900 shadow-xs transition duration-fast hover:-translate-y-0.5 hover:shadow-md">{a.name}</a></li>
      ))}
    </ul>
    <div class="mt-10 flex flex-col items-center gap-4">
      <a href="/areas" class="btn-forest">Check my address</a>
      <p class="text-base text-tone-fg">Not listed? <a href={business.phoneHref} class="font-semibold underline underline-offset-4">Call {business.phone}</a> — we might already be in your neighborhood.</p>
    </div>
  </Section>

  {/* 10. GUIDES & QUESTIONS — new. Thirty-two written pages stop being orphans here (P15 §8). */}
  <Section tone="white" labelledby="knowledge-title">
    <KnowledgeBand guides={guides} questions={questionLinks} />
  </Section>

  {/* 11. FREQUENTLY ASKED QUESTIONS — the live shape: centred, the answers on one white card */}
  <Section tone="cream" labelledby="faq-title">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow-chip mb-5">Common questions</p>
      <h2 id="faq-title" class="text-h2 text-tone-heading">Frequently Asked Questions</h2>
      <p class="mt-4 text-lg text-tone-muted">Everything you need to know before getting started.</p>
    </div>
    <div class="mx-auto mt-10 max-w-3xl rounded-card bg-paper px-6 shadow-card sm:px-8"><Faq items={faqs} card /></div>
    <p class="mt-8 text-center text-base text-tone-muted">Still have a question? <a href={business.phoneHref} class="link whitespace-nowrap">Call or text {business.phone}</a> — we answer.</p>
  </Section>

  {/* 12. BOOK YOUR SERVICE — the live page's closing band on the brand green, with the ZIP
       field inside it */}
  <CloseCta source="home-close" title="Book Your Service" above="cream" />
</Site>
