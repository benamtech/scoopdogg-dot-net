---
import Site from '../layouts/Site.astro';
import { SITE_URL } from '../lib/constants';
import { ARTICLES } from '../lib/articles';
import Page from '../pages_react/ResourcesPage';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Scoop Dogg Resources',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: ARTICLES.map((a, i) => ({
      '@type': 'ListItem', position: i + 1, name: a.title, url: `${SITE_URL}/resources/${a.slug}`,
    })),
  },
};
---
<Site jsonLd={jsonLd} title={'Resources | Dog Waste, Turf and Yard Guides for Ventura County'} description={'Local guides on dog waste disposal rules, artificial turf cleaning, drought-tolerant yards and city-by-city ordinances.'} canonicalPath="/resources">
  <Page />
</Site>
