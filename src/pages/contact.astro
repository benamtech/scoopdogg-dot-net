---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav';
import Footer from '../components/Footer';
import { SITE_URL } from '../lib/constants';
import Page from '../pages_react/ContactPage';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'ContactPage',
  name: 'Contact Scoop Dogg',
  mainEntity: {
    '@type': 'LocalBusiness', '@id': `${SITE_URL}/#business`, name: 'Scoop Dogg',
    telephone: '+18058698070', email: 'josue@scoopdogg.net',
    contactPoint: { '@type': 'ContactPoint', telephone: '+18058698070', contactType: 'customer service', areaServed: 'US-CA', availableLanguage: 'English' },
  },
};
---
<Base jsonLd={jsonLd} title={'Contact Scoop Dogg | Ventura County Dog Poop Cleanup'} description={'Call (805) 869-8070 or send a message. Free quote in 60 seconds, most new customers confirmed within 24 hours.'} canonicalPath="/contact">
  <Nav client:load />
  <main><Page  /></main>
  <Footer />
</Base>
