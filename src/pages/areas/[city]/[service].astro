---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav';
import Footer from '../../../components/Footer';
import CityServicePage from '../../../pages_react/CityServicePage';
import { CITIES } from '../../../lib/cities';
import { SERVICES } from '../../../lib/services';
import { SITE_URL } from '../../../lib/constants';
import { CITY_SERVICE_PAGES, CITIES_WITH_DEMAND } from '../../../lib/site-config';

export function getStaticPaths() {
  if (CITY_SERVICE_PAGES === 'none') return [];
  const cities =
    CITY_SERVICE_PAGES === 'demand'
      ? CITIES.filter((c) => CITIES_WITH_DEMAND.includes(c.slug))
      : CITIES;
  return cities.flatMap((c) =>
    SERVICES.map((s) => ({ params: { city: c.slug, service: s.slug }, props: { c, s } })),
  );
}
const { c, s } = Astro.props;
const title = `${s.name} in ${c.name}, CA | Scoop Dogg`;
const description = `${s.shortName} in ${c.name}. ${s.pricingNote} Serving ${c.name} and the surrounding Ventura County area.`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: `${s.name} in ${c.name}`, description,
  provider: { '@type': 'LocalBusiness', name: 'Scoop Dogg', '@id': `${SITE_URL}/#business` },
  areaServed: { '@type': 'City', name: c.name, addressRegion: 'CA' },
};
---
<Base title={title} description={description} canonicalPath={`/areas/${c.slug}/${s.slug}`} jsonLd={jsonLd}>
  <Nav client:load />
  <main><CityServicePage city={c.slug} service={s.slug} /></main>
  <Footer />
</Base>
