---
/**
 * A city page: local, specific, and one step from a price. The city rides along into booking
 * (the address form carries it), and the service days show when Josue has set them (P6).
 */
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/site/PageHero.astro';
import PackageCards from '../../components/site/PackageCards.astro';
import ReviewQuotes from '../../components/site/ReviewQuotes.astro';
import Faq from '../../components/site/Faq.astro';
import CloseCta from '../../components/site/CloseCta.astro';
import { areas, areaBySlug, markets, services, headlinePrice } from '../../lib/catalog';
import { weekdayName } from '../../shared/pricing';
import { SITE_URL } from '../../lib/constants';

export function getStaticPaths() {
  return areas.map((a) => ({ params: { city: a.slug } }));
}
const { city } = Astro.params;
const a = areaBySlug(city!)!;
const market = markets().find((m) => m.market === a.market);
const nearby = (a.nearby_slugs ?? []).map((n) => areaBySlug(n)).filter(Boolean) as typeof areas;
const days = (a.service_weekdays ?? []).map(weekdayName);
const title = a.meta_title || `Dog Poop Cleanup in ${a.name}, CA | Scoop Dogg`;
const description = a.meta_description || `Weekly dog poop cleanup in ${a.name}. Same day every week, first month half off, no contract.`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Service', name: `Dog poop cleanup in ${a.name}`, description,
    provider: { '@type': 'LocalBusiness', '@id': `${SITE_URL}/#business`, name: 'Scoop Dogg', telephone: '+18058698070' },
    areaServed: { '@type': 'City', name: `${a.name}, CA` },
  },
  ...(a.faqs?.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: a.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Site title={title} description={description} canonicalPath={`/areas/${a.slug}`} jsonLd={jsonLd}>
  <PageHero
    eyebrow={market?.label ? `${a.name} · ${market.label.replace(/^the /, 'the ')}` : a.name}
    title={`Dog poop cleanup in ${a.name}`}
    lede={a.intro ?? description}
    crumbs={[{ href: '/areas', label: 'Areas' }]}
    form
    formCity={a.slug}
    source={`area-${a.slug}`}
  >
    <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-base text-forest-800">
      <li>✓ {days.length ? `In ${a.name} on ${days.join(' & ')}` : 'Same day every week'}</li>
      <li>✓ First month half off</li>
      <li>✓ No contract</li>
    </ul>
  </PageHero>

  <section class="bg-paper py-section" aria-labelledby="city-plans">
    <div class="container-site">
      <div class="mx-auto max-w-narrow text-center">
        <h2 id="city-plans" class="text-h2 text-forest-900">Weekly scooping in {a.name}</h2>
        <p class="mt-3 text-lg text-ink-500">One monthly price by how many dogs you have.</p>
      </div>
      <div class="mx-auto mt-10 max-w-5xl"><PackageCards service="weekly-pooper-scooper-service" compact /></div>
    </div>
  </section>

  {(a.local_context || a.neighborhoods?.length) && (
    <section class="bg-cream py-section" aria-labelledby="local">
      <div class="container-site grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 id="local" class="text-h2 text-forest-900">Yards in {a.name}</h2>
          {a.local_context && <p class="mt-5 text-lg text-ink-700">{a.local_context}</p>}
        </div>
        {a.neighborhoods?.length > 0 && (
          <div class="lg:col-span-5">
            <h3 class="text-lg font-semibold text-forest-900">Neighborhoods we serve</h3>
            <p class="mt-3 text-base leading-relaxed text-ink-700">{a.neighborhoods.join(' · ')}</p>
            {nearby.length > 0 && (
              <>
                <h3 class="mt-8 text-lg font-semibold text-forest-900">Nearby</h3>
                <p class="mt-3 text-base">{nearby.map((n, i) => <><a href={`/areas/${n.slug}`} class="link">{n.name}</a>{i < nearby.length - 1 ? ', ' : ''}</>)}</p>
              </>
            )}
          </div>
        )}
      </div>
    </section>
  )}

  <section class="bg-forest-900 py-section" aria-labelledby="city-reviews">
    <div class="container-site">
      <h2 id="city-reviews" class="text-h2 text-white">What customers say</h2>
      <div class="mt-10"><ReviewQuotes dark limit={3} /></div>
    </div>
  </section>

  <section class="bg-paper py-section-sm" aria-labelledby="city-services">
    <div class="container-site">
      <h2 id="city-services" class="text-h3 text-forest-900">Also available in {a.name}</h2>
      <ul class="mt-6 flex flex-wrap gap-2">
        {services.filter((s) => s.slug !== 'weekly-pooper-scooper-service').map((s) => {
          const p = headlinePrice(s.slug);
          return <li><a href={`/services/${s.slug}`} class="inline-flex items-center gap-2 rounded-md border border-line bg-paper px-4 py-2.5 text-base text-forest-800 hover:border-forest-300">{s.name}{p && <span class="text-sm text-ink-500">{p.text}{p.per}</span>}</a></li>;
        })}
      </ul>
    </div>
  </section>

  {a.faqs?.length > 0 && (
    <section class="bg-cream py-section" aria-labelledby="city-faq">
      <div class="container-site">
        <h2 id="city-faq" class="text-center text-h2 text-forest-900">{a.name} questions</h2>
        <div class="mx-auto mt-10 max-w-narrow"><Faq items={a.faqs} /></div>
      </div>
    </section>
  )}
  <CloseCta source={`area-${a.slug}-close`} city={a.slug} title={`Clean yards in ${a.name}, every week.`} />
</Site>
