---
import Site from '../layouts/Site.astro';
import PageHero from '../components/site/PageHero.astro';
import CloseCta from '../components/site/CloseCta.astro';
import { markets, regionSentence } from '../lib/catalog';
---
<Site title="Service Areas | Ventura & Santa Barbara Counties | Scoop Dogg" description={`Weekly dog poop cleanup across ${regionSentence()}.`} canonicalPath="/areas">
  <PageHero eyebrow="Where we work" title="Local routes across two counties" lede={`${regionSentence()}. Each city has set service days, which is how every customer gets the same day every week.`} form source="areas-hero" />
  <section class="bg-paper py-section">
    <div class="container-site grid gap-10 md:grid-cols-2">
      {markets().map((m) => (
        <div class="rounded-xl border border-line bg-paper p-7">
          <h2 class="text-h3 text-forest-900">{m.label.replace(/^the /, 'The ')}</h2>
          <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2">
            {m.areas.map((a) => <li><a href={`/areas/${a.slug}`} class="group flex items-center justify-between rounded-md px-3 py-2 text-base text-forest-800 hover:bg-forest-50"><span>{a.name}</span><span class="text-forest-300 group-hover:text-forest-600" aria-hidden="true">→</span></a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <p class="container-site mt-10 text-center text-base text-ink-700">Not listed? <a href="/book" class="link">Enter your address</a> — we're adding routes as we grow.</p>
  </section>
  <CloseCta source="areas-close" />
</Site>
