---
import Base from '../layouts/Base.astro';
import Logo from '../components/site/Logo.astro';
import BookingFlow from '../components/booking/BookingFlow';
import { catalog, areas, services, business, markets, trust, postalCodes, setting } from '../lib/catalog';
import { DEMO_MODE } from '../lib/demo';

// The booking gets a focused shell: the logo, a phone number and nothing else to click away to.
const marketLabels = Object.fromEntries(markets().map((m) => [m.market, m.label.replace(/^the /, 'The ')]));
const slim = {
  services: catalog.services,
  tiers: catalog.tiers,
  packages: catalog.packages,
  offers: catalog.offers,
};
---
<Base title="See your price and book | Scoop Dogg" description="See your monthly price for weekly dog poop cleanup and book online in about a minute. First month half off, no contract." canonicalPath="/book">
  <header class="tone-white border-b border-line bg-paper">
    <div class="container-site flex h-[72px] items-center justify-between">
      <Logo size="md" />
      <div class="flex items-center gap-4 text-base">
        <a href={business.phoneHref} class="hidden font-medium text-forest-800 sm:inline">{business.phone}</a>
        <a href="/account" class="font-medium text-forest-700 hover:text-forest-900">Sign in</a>
      </div>
    </div>
  </header>
  <main id="main" class="min-h-[calc(100vh-72px)] tone-tint bg-tone-bg pb-28 pt-10 lg:pb-section-sm lg:pt-14">
    <div class="container-site">
      <BookingFlow
        client:load
        catalog={slim}
        areas={areas.filter((a) => a.bookable).map((a) => ({ slug: a.slug, name: a.name, market: a.market, bookable: a.bookable }))}
        marketLabels={marketLabels}
        services={services.map((s) => ({ slug: s.slug, name: s.name, what_includes: s.what_includes ?? [] }))}
        zipMap={postalCodes}
        lanesEnabled={setting('booking.lanes_enabled', 'prepay')}
        phone={business.phone}
        phoneHref={business.phoneHref}
        demo={DEMO_MODE}
        guarantee={trust.guarantee}
      />
    </div>
    <!-- THE CITY LIST IS CONTENT, NOT A DROPDOWN. It used to be a <select> inside the funnel's
         first step; asking for a ZIP instead (P16 §2) took sixteen city names out of the page,
         and those names are how a reader checks coverage before typing and how a crawler learns
         which places this business serves. So it is here, as text, linking to the pages that
         answer for each city. -->
    <section class="container-site mt-section-sm border-t border-line pt-12" aria-labelledby="where-we-work">
      <h2 id="where-we-work" class="text-h3 text-forest-900">Where we work</h2>
      <p class="mt-3 max-w-2xl text-base text-ink-700">
        Weekly dog waste removal across Ventura County, the Conejo Valley, Malibu and the Santa Barbara
        coast. Type your ZIP above and we'll tell you your day and your price — or if we're not on a
        route near you yet, we'll say so and tell you when we are.
      </p>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-base">
        {areas.filter((a) => a.bookable).map((a) => (
          <li><a href={`/areas/${a.slug}`} class="link">{a.name}</a></li>
        ))}
      </ul>
    </section>

    <section class="container-site mt-section-sm border-t border-line pt-12" aria-labelledby="why-book">
      <h2 id="why-book" class="text-h3 text-forest-900">Why book online with Scoop Dogg</h2>
      <div class="mt-8 grid gap-8 text-base text-ink-700 md:grid-cols-3">
        <div><h3 class="text-lg font-semibold text-forest-900">Your price, up front</h3><p class="mt-2">Monthly plans priced by how many dogs you have, shown before we ask for anything else. Your first month of weekly scooping is half off.</p></div>
        <div><h3 class="text-lg font-semibold text-forest-900">Same day every week</h3><p class="mt-2">We serve each city on set days, so the day you pick is your day every week. You never need to be home.</p></div>
        <div><h3 class="text-lg font-semibold text-forest-900">In control, always</h3><p class="mt-2">Skip a week, pause for vacation, update your card or cancel from your account. No contract and no sign-up fees. Payments are processed securely by Stripe.</p></div>
      </div>
    </section>
  </main>
</Base>
