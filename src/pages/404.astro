---
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import mascot from '../assets/art/dog-with-shovel.png';
---
<Site title="Page not found | Scoop Dogg" description="That page is not here." canonicalPath="/404" noindex mobileCta={false}>
  <section class="tone-white bg-paper py-section">
    <div class="container-site grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-5">404</p>
        <h1 class="text-h1 text-forest-900">This page wandered off.</h1>
        <p class="mt-5 max-w-md text-lg text-ink-700">Our dog sniffed everywhere and could not find it. Try one of these instead.</p>
        <div class="mt-9 flex flex-wrap gap-3"><a href="/book" class="btn-primary">See my price</a><a href="/pricing" class="btn-ghost">Pricing</a><a href="/" class="btn-ghost">Home</a></div>
      </div>
      <div class="flex justify-center lg:col-span-5" aria-hidden="true">
        <Image src={mascot} alt="" widths={[260, 520]} sizes="260px" class="h-auto w-56 lg:w-64" />
      </div>
    </div>
  </section>
</Site>
