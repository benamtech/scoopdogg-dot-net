---
/**
 * About Josue. Bands: hero on the brand green with his photo -> his story (white) -> what we
 * stand for (orange, white cards) -> the guarantee (white) -> close (green, because the band
 * two above is orange and the page ends on the owner's colours).
 */
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import PageHero from '../components/site/PageHero.astro';
import Section from '../components/site/Section.astro';
import GuaranteeStamp from '../components/site/GuaranteeStamp.astro';
import CloseCta from '../components/site/CloseCta.astro';
import { trust, regionSentence, business } from '../lib/catalog';
import josue from '../assets/photos/4824.jpg';
import mascot from '../assets/art/dog-with-shovel.png';
const values = [
  { t: 'Same day, every week', d: 'You never wonder whether we are coming. Your day is your day.' },
  { t: 'The whole yard, every time', d: 'Behind the planters, along the fence line, under the deck. Every corner.' },
  { t: 'No strings', d: 'No contracts and no sign-up fees. Skip, pause or cancel from your account.' },
];
const check = 'M5 12l5 5 9-10';
---
<Site title="About Scoop Dogg | Locally Owned Pooper Scoopers" description={`Scoop Dogg is a locally owned dog waste removal company serving ${regionSentence()}.`} canonicalPath="/about">
  <PageHero tone="forest" eyebrow="About us" title="A clean yard, done personally" lede={`Scoop Dogg is a locally owned pooper scooper and turf care company serving ${regionSentence()}.`}>
    <ul class="mt-8 flex flex-wrap gap-x-7 gap-y-3 text-base font-medium text-white">
      {trust.insured && <li class="inline-flex items-center gap-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-amber-400" aria-hidden="true"><path d={check} /></svg>Fully insured</li>}
      {trust.backgroundChecked && <li class="inline-flex items-center gap-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-amber-400" aria-hidden="true"><path d={check} /></svg>Background-checked</li>}
      <li class="inline-flex items-center gap-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-amber-400" aria-hidden="true"><path d={check} /></svg>Locally owned</li>
    </ul>
    <div slot="aside" class="relative mx-auto max-w-sm lg:max-w-none">
      <Image src={josue} alt="Josue, owner of Scoop Dogg" widths={[400, 800]} sizes="(min-width: 1024px) 440px, 90vw" class="aspect-[4/5] w-full rounded-xl object-cover shadow-lg" loading="eager" />
    </div>
  </PageHero>

  <Section tone="white" labelledby="story-title">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4">Meet Josue</p>
        <h2 id="story-title" class="text-h1 text-forest-900">“I know my clients' dogs by name.”</h2>
        <div class="mt-8 space-y-5 text-lg text-ink-700">
          <p>I'm Josue. I started Scoop Dogg because I got tired of seeing dog owners stressed about something that should be simple. You love your dog. You shouldn't have to dread your own backyard.</p>
          <p>I know my clients' dogs by name, I know which gates stick, and I know which yards have the sneaky spots. This isn't a side hustle — it's my business, and I take it personally.</p>
          <p class="font-serif text-h3 text-forest-800">Every visit, every yard, done right.</p>
        </div>
        <p class="mt-8 text-base text-ink-700">Questions? Call or text <a href={business.phoneHref} class="link">{business.phone}</a>.</p>
      </div>
      <div class="hidden justify-center lg:col-span-5 lg:flex" aria-hidden="true">
        <Image src={mascot} alt="" widths={[300, 600]} sizes="300px" class="h-auto w-72" />
      </div>
    </div>
  </Section>

  <Section tone="orange" labelledby="values-title">
    <p class="eyebrow mb-4">What we stand for</p>
    <h2 id="values-title" class="text-h1 text-white">Three promises, every week</h2>
    <ol class="mt-12 grid gap-4 md:grid-cols-3 lg:gap-5">
      {values.map((v, i) => (
        <li class="tone-white rounded-xl bg-paper p-7 shadow-md">
          <span class="font-serif text-h2 leading-none text-orange-700" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-5 font-sans text-xl font-semibold text-forest-900">{v.t}</h3>
          <p class="mt-2 text-base text-ink-700">{v.d}</p>
        </li>
      ))}
    </ol>
  </Section>

  {trust.guarantee && (
    <Section tone="white" size="sm">
      <GuaranteeStamp size={120} />
    </Section>
  )}
  <CloseCta source="about-close" tone="forest" />
</Site>
